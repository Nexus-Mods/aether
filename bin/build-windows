#!/usr/bin/env bash
# Cross-build Aether's Windows natives from Linux or macOS: the x64 injector and
# shim DLL, the i686 pair for 32-bit programs, and every test fixture: the
# aether-fixtures programs (read, Steam, NVAPI, registry, writepath, escape,
# prefs), staticimp and its vproxy.dll, and aether-inject's aether-probe, the set
# bin/build-natives.ps1 -Fixtures builds on Windows. They run inside Wine; the
# director that serves them is native.
#
# Run from anywhere (it changes into the repository root itself). The four
# natives are staged into target/natives, under the names a director looks
# for; the fixtures go to target/<profile>/.
#
# Needs: rustup targets x86_64- and i686-pc-windows-msvc, cargo-xwin, and
# clang, lld and llvm 19 or later.
# The first run downloads the MSVC CRT and Windows SDK into ~/.cache/cargo-xwin
# (XWIN_ACCEPT_LICENSE=1 accepts Microsoft's license for that download).
#
# The ARTIFACTS array below is the one list of what it stages; keep the
# cargo -p list below in step with it by hand.
#
# Usage: bin/build-windows [--release] [-h|--help]
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bin/build-windows [--release]

Cross-builds the Windows half of the Proton path with cargo-xwin and copies
the natives into target/natives/ and the fixtures into
target/<profile>/ (debug by default).

  --release   build with the release profile
  -h, --help  show this help

Needs: rustup targets x86_64- and i686-pc-windows-msvc, cargo-xwin, and
clang, lld and llvm 19 or later.
EOF
}

die() {
  echo "build-windows: $*" >&2
  exit 1
}

profile=debug
flags=()
for arg in "$@"; do
  case "$arg" in
    --release)
      profile=release
      flags=(--release)
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      die "unknown argument: $arg"
      ;;
  esac
done

# Check the toolchain up front, so a missing tool is named here rather than
# surfacing as an opaque failure deep inside cargo.
command -v cargo > /dev/null || die "cargo not found (install Rust via rustup)"
cargo xwin --version > /dev/null 2>&1 \
  || die "cargo-xwin not found (cargo install --locked cargo-xwin)"
command -v rustup > /dev/null || die "rustup not found (needed for the Windows target)"
command -v jq > /dev/null || die "jq not found (it reads contract/artifacts.json: sudo apt install jq, or brew install jq)"
# LLVM 19 or later: lld-link 18 rejects the `/EXPORT:_DllMain@12,EXPORTAS,DllMain`
# rustc gives the i686 shim. Ubuntu's versioned packages put the unversioned
# names (clang, clang-cl, lld-link, llvm-lib) only in /usr/lib/llvm-19/bin.
llvm_hint='sudo apt install clang-19 lld-19 llvm-19, then export PATH="/usr/lib/llvm-19/bin:$PATH"; on macOS, brew install llvm lld and put their bin folders on PATH'
for tool in clang lld-link; do
  command -v "$tool" > /dev/null || die "$tool not found ($llvm_hint)"
done
lld_major="$(lld-link --version 2>&1 | sed -n 's/.*LLD \([0-9][0-9]*\).*/\1/p' | head -n 1)" || true
[ -n "$lld_major" ] && [ "$lld_major" -ge 19 ] \
  || die "lld-link ${lld_major:-of unknown version} found, 19 or later needed ($llvm_hint)"

cd "$(dirname "$0")/.."

# Asked here, at the root, rustup answers for rust-toolchain.toml's toolchain, the
# one cargo builds with (bin/bootstrap installs it, targets and all).
for t in x86_64-pc-windows-msvc i686-pc-windows-msvc; do
  rustup target list --installed 2> /dev/null | grep -qx "$t" \
    || die "rust target $t missing (at the repository root: rustup toolchain install, or rustup target add $t)"
done

target=x86_64-pc-windows-msvc
# the 32-bit injector and shim, for 32-bit (WOW64) programs: built for i686
# and staged under these names
target32=i686-pc-windows-msvc
# What is staged comes from contract/artifacts.json, the list a release ships
# and bin/build-natives.ps1 reads too: the four natives under their staged
# names, then the fixtures.
contract=contract/artifacts.json
native() { jq -er ".natives.$1.$2" "$contract"; }
injector64="$(native x64 injector)" && shim64="$(native x64 shim)" \
  && injector32="$(native x86 injector)" && shim32="$(native x86 shim)" \
  || die "$contract lacks a native's name"
ARTIFACTS=("$injector64" "$shim64" "$injector32" "$shim32")
while IFS= read -r f; do
  case " ${ARTIFACTS[*]} " in
    *" $f "*) ;;
    *) ARTIFACTS+=("$f") ;;
  esac
done < <(jq -er '.fixtures[]' "$contract" | tr -d '\r')

export XWIN_ACCEPT_LICENSE=1
# the CRT and SDK libraries of both architectures (the 32-bit injector and shim link x86)
export XWIN_ARCH=x86,x86_64

# `libudis86-sys` (reached through `retour`, i.e. the shim) calls `memset`
# without including string.h and papers over it with the GCC-only flag
# `-includestring.h`. cl.exe tolerates the implicit declaration; clang-cl drops
# the unknown flag and then rejects it as an error. Demote that one diagnostic
# back to a warning. A forced include (`/FIstring.h`) is *not* a substitute: it
# reaches every C compile for the target, including blake3's preprocessed
# assembly, which it breaks.
#
# Set here rather than in .cargo/config.toml so a native Windows build — real
# cl.exe, which would warn about the unknown flag — never sees it. The hyphenated
# name is deliberate: cargo-xwin sets the underscored
# `CFLAGS_x86_64_pc_windows_msvc` itself, and cc-rs reads both.
# Bash cannot export a hyphenated name, so it goes in through `env`.
cross=(env "CFLAGS_x86_64-pc-windows-msvc=-Wno-error=implicit-function-declaration"
  "CFLAGS_i686-pc-windows-msvc=-Wno-error=implicit-function-declaration")
# `${flags[@]+…}`: macOS's bash 3.2 calls an empty array unbound under `set -u`.
"${cross[@]}" cargo xwin build ${flags[@]+"${flags[@]}"} --target "$target" \
  -p aether-inject -p aether-shim-dll -p aether-fixtures -p aether-fixture-vproxy
# staticimp links vproxy.dll.lib through its build.rs, with no Cargo edge to
# the cdylib (cargo#6313): vproxy is built first, in the invocation above
"${cross[@]}" cargo xwin build ${flags[@]+"${flags[@]}"} --target "$target" \
  -p aether-fixture-staticimp

"${cross[@]}" cargo xwin build ${flags[@]+"${flags[@]}"} --target "$target32" \
  -p aether-inject --bin aether-injector
"${cross[@]}" cargo xwin build ${flags[@]+"${flags[@]}"} --target "$target32" -p aether-shim-dll

src="target/$target/$profile"
src32="target/$target32/$profile"
# the four natives under target/natives (as bin/build-natives.ps1 stages them),
# and everything beside the host binaries in target/<profile>/, where the
# tests look
natives_dst="target/natives"
dst="target/$profile"
mkdir -p "$natives_dst" "$dst"
for f in "${ARTIFACTS[@]}"; do
  case "$f" in
    "$injector64") from="$src/aether-injector.exe" ;;
    "$shim64") from="$src/aether_shim_dll.dll" ;;
    "$injector32") from="$src32/aether-injector.exe" ;;
    "$shim32") from="$src32/aether_shim_dll.dll" ;;
    *) from="$src/$f" ;;
  esac
  [[ -f "$from" ]] || die "the build succeeded but did not produce $from"
  cp -f "$from" "$dst/$f"
  echo "  $dst/$f"
  case "$f" in
    "$injector64" | "$shim64" | "$injector32" | "$shim32")
      cp -f "$from" "$natives_dst/$f"
      echo "  $natives_dst/$f"
      ;;
  esac
done
