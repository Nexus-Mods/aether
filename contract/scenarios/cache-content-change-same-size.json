{
  "name": "cache-content-change-same-size",
  "description": "A file a writable provider holds, its content changed at the same size by a rename over it, a delete and create, a truncating OPEN and rewrite, and a RENAME_X over it, read before and after each, inline and in bulk; and a reader open while another handle writes. Every read is the bytes now (wire.md 3.4.4; 3.4.7; 3.4.13). The shim's read cache keys a file by (root, folded path, size, `mount_gen`), so a director that called these opens `immutable` would break 3.4.3 (\"never set it for a file a writable provider holds\"); aether-conform checks the cache rule across the steps. Both roots are writable as a whole (contract/scenarios/README.md, \"Tree\").",
  "tree": {"roots": [{"id": 0, "files": [{"path": "w/a", "contents": "AAAA"}, {"path": "w/b", "contents": "BBBB"}, {"path": "w/c", "contents": "CCCC"}], "writable": ["."]}, {"id": 1, "files": [{"path": "w/n", "contents": "EEEE"}], "writable": ["."]}]},
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "w/b"}, "expect": {"reply": {"fh": 1, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"reply": {"data": "BBBB"}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16, "slot_flags": ["read_bulk"]}, "expect": {"reply": {"data": "BBBB"}}},
    {"request": {"op": "rename", "root": 0, "from": "w/a", "to": "w/b"}, "expect": {"status": "ok"}, "note": "wire.md 3.4.7: replaced at the same size"},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "w/b"}, "expect": {"reply": {"fh": 2, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 16}, "expect": {"reply": {"data": "AAAA"}}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 16, "slot_flags": ["read_bulk"]}, "expect": {"reply": {"data": "AAAA"}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"one_of": [{"reply": {"data": "BBBB"}}, {"status": "io-error"}, {"status": "not-found"}], "wire": "3.4.8"}, "note": "wire.md 3.4.7, 3.4.8: the replaced file, to its own handle"},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "delete", "root": 0, "path": "w/b"}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "w/b"}, "expect": {"reply": {"fh": 3, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 3, "offset": 0, "data": "DDDD"}, "expect": {"reply": {"written": 4}}},
    {"request": {"op": "close", "fh": 3}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "w/b"}, "expect": {"reply": {"fh": 4, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 4, "offset": 0, "len": 16}, "expect": {"reply": {"data": "DDDD"}}},
    {"request": {"op": "read", "fh": 4, "offset": 0, "len": 16, "slot_flags": ["read_bulk"]}, "expect": {"reply": {"data": "DDDD"}}},
    {"request": {"op": "close", "fh": 4}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "trunc"], "path": "w/b"}, "expect": {"reply": {"fh": 5, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 5, "offset": 0, "data": "FFFF"}, "expect": {"reply": {"written": 4}}},
    {"request": {"op": "close", "fh": 5}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "w/b"}, "expect": {"reply": {"fh": 6, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 6, "offset": 0, "len": 16}, "expect": {"reply": {"data": "FFFF"}}},
    {"request": {"op": "read", "fh": 6, "offset": 0, "len": 16, "slot_flags": ["read_bulk"]}, "expect": {"reply": {"data": "FFFF"}}},
    {"request": {"op": "close", "fh": 6}, "expect": {"status": "ok"}},
    {"request": {"op": "rename-x", "from_root": 1, "to_root": 0, "from": "w/n", "to": "w/b"}, "expect": {"status": "ok"}, "note": "wire.md 3.4.13: replacing what is there"},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "w/b"}, "expect": {"reply": {"fh": 7, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 7, "offset": 0, "len": 16}, "expect": {"reply": {"data": "EEEE"}}},
    {"request": {"op": "read", "fh": 7, "offset": 0, "len": 16, "slot_flags": ["read_bulk"]}, "expect": {"reply": {"data": "EEEE"}}},
    {"request": {"op": "close", "fh": 7}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "w/c"}, "expect": {"reply": {"fh": 8, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 8, "offset": 0, "len": 16}, "expect": {"reply": {"data": "CCCC"}}},
    {"request": {"op": "read", "fh": 8, "offset": 0, "len": 16, "slot_flags": ["read_bulk"]}, "expect": {"reply": {"data": "CCCC"}}},
    {"request": {"op": "open", "root": 0, "flags": ["write"], "path": "w/c"}, "expect": {"reply": {"fh": 9, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 9, "offset": 0, "data": "GGGG"}, "expect": {"reply": {"written": 4}}},
    {"request": {"op": "read", "fh": 8, "offset": 0, "len": 16}, "expect": {"reply": {"data": "GGGG"}}},
    {"request": {"op": "read", "fh": 8, "offset": 0, "len": 16, "slot_flags": ["read_bulk"]}, "expect": {"reply": {"data": "GGGG"}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "w/c"}, "expect": {"reply": {"fh": 10, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 10, "offset": 0, "len": 16}, "expect": {"reply": {"data": "GGGG"}}},
    {"request": {"op": "read", "fh": 10, "offset": 0, "len": 16, "slot_flags": ["read_bulk"]}, "expect": {"reply": {"data": "GGGG"}}},
    {"request": {"op": "close", "fh": 8}, "expect": {"status": "ok"}},
    {"request": {"op": "close", "fh": 9}, "expect": {"status": "ok"}},
    {"request": {"op": "close", "fh": 10}, "expect": {"status": "ok"}}
  ]
}
