{
  "name": "delete-and-excl-edges",
  "description": "Names freed by DELETE and RENAME are free at once for an exclusive create, in any case, which keeps its own spelling; a renamed file's new name is taken (wire.md 3.4.3: OPEN_EXCL \"fail with `ST_EXISTS` if present\"; 3.2: the fold decides what is present). A directory whose only child is an empty directory has something under it, ST_IO_ERROR (3.4.8). OPEN_CREATE of an existing file opens it without truncating (3.4.3).",
  "tree": {"roots": [{"id": 0, "files": [{"path": "saves/x.txt", "contents": "x"}, {"path": "saves/y.txt", "contents": "y"}, {"path": "saves/F.txt", "contents": "f"}], "dirs": ["saves/only-dir", "saves/only-dir/inner"], "writable": ["saves"]}]},
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["write", "create", "excl"], "path": "saves/x.txt"}, "expect": {"status": "exists"}},
    {"request": {"op": "delete", "root": 0, "path": "saves/x.txt"}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create", "excl"], "path": "saves/X.TXT"}, "expect": {"reply": {"fh": 1, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}, "note": "wire.md 3.4.8: the name is free at once"},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "rename", "root": 0, "from": "saves/y.txt", "to": "saves/z.txt"}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create", "excl"], "path": "saves/y.txt"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create", "excl"], "path": "saves/Z.txt"}, "expect": {"status": "exists"}, "note": "wire.md 3.4.3, 3.2"},
    {"request": {"op": "delete", "root": 0, "path": "saves/only-dir"}, "expect": {"status": "io-error"}, "note": "wire.md 3.4.8: an empty directory is something under it"},
    {"request": {"op": "getattr", "root": 0, "path": "saves/only-dir/inner"}, "expect": {"reply": {"found": true, "is_dir": true, "size": 0, "mtime": 0}}},
    {"request": {"op": "delete", "root": 0, "path": "saves/only-dir/inner"}, "expect": {"status": "ok"}},
    {"request": {"op": "delete", "root": 0, "path": "saves/ONLY-DIR"}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/only-dir"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "delete", "root": 0, "path": "SAVES/f.TXT"}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create", "excl"], "path": "saves/f.TXT"}, "expect": {"reply": {"fh": 3, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "close", "fh": 3}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "X.TXT", "is_dir": false, "size": 0, "mtime": 0}, {"name": "y.txt", "is_dir": false, "size": 0, "mtime": 0}, {"name": "z.txt", "is_dir": false, "size": 1, "mtime": 0}, {"name": "f.TXT", "is_dir": false, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "saves/z.txt"}, "expect": {"reply": {"fh": 4, "size": 1, "is_dir": false, "immutable": false, "mount_gen": 0}}, "note": "wire.md 3.4.3: OPEN_CREATE does not truncate"},
    {"request": {"op": "close", "fh": 4}, "expect": {"status": "ok"}}
  ]
}
