{
  "name": "delete-dir-after-open-child",
  "description": "A directory whose only file was deleted while a handle was open on it has nothing under it, so it is deleted (wire.md 3.4.8: \"a directory with nothing under it, is deleted\"; \"A file with open handles is deleted like any other\"); the old handle may read the deleted file's last bytes or fail, and closes ST_OK; a directory and a file made again at the names are new and empty.",
  "tree": {"roots": [{"id": 0, "files": [{"path": "saves/d/f", "contents": "x"}], "writable": ["saves"]}]},
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/d/f"}, "expect": {"reply": {"fh": 1, "size": 1, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "delete", "root": 0, "path": "saves/d/f"}, "expect": {"status": "ok"}},
    {"request": {"op": "delete", "root": 0, "path": "saves/d"}, "expect": {"status": "ok"}, "note": "wire.md 3.4.8: the deleted file is not under it, open or not"},
    {"request": {"op": "getattr", "root": 0, "path": "saves/d"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"one_of": [{"reply": {"data": "x"}}, {"status": "io-error"}, {"status": "not-found"}], "wire": "3.4.8"}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}, "note": "wire.md 3.4.8"},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "saves/d"}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves/d"}, "expect": {"reply": {"entries": []}}},
    {"request": {"op": "open", "root": 0, "flags": ["read", "write", "create"], "path": "saves/d/f"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}, "note": "wire.md 3.4.8: a new file, not the deleted one"},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 16}, "expect": {"reply": {"data": ""}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}}
  ]
}
