{
  "name": "escape-paths",
  "description": "A path that leaves its root (`..` above the root) is an error (wire.md 3.2: \"must treat a path that would leave its root ... as an error\"; 3.5: ST_BAD_REQUEST \"a path escaped its root (recommended; see 3.5.1)\"). Where 3.5.1's table shows the directors differing (GETATTR found=0, ST_NOT_FOUND for READDIR, DELETE, MKDIR, STORED_NAMES) the answers it lists are accepted; OPEN, RENAME and RENAME_X are ST_BAD_REQUEST in both. STAGE_EXEC is not-supported when the director stages nothing (3.5.1: checked first), else bad-request or not-found. Every root is writable as a whole, so a read-only answer cannot stand in for the escape error. A mounted path is not reachable through it.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "secret.txt", "contents": "top"},
        {"path": "data/a.esp", "contents": "abc"}
      ],
       "dirs": ["saves"],
       "writable": ["."]},
      {"id": 1,
       "files": [{"path": "other.txt", "contents": "o"}],
       "writable": ["."]}
    ]
  },
  "steps": [
    {"request": {"op": "getattr", "root": 0, "path": "../x"}, "expect": {"one_of": [{"status": "bad-request"}, {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}], "wire": "3.5.1"}},
    {"request": {"op": "readdir", "root": 0, "path": "../x"}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "not-found"}], "wire": "3.5.1"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "../x"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "../x"}, "expect": {"status": "bad-request"}, "note": "a write open that creates"},
    {"request": {"op": "delete", "root": 0, "path": "../x"}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "not-found"}], "wire": "3.5.1"}},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "../x"}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "not-found"}], "wire": "3.5.1"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "../x"}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "not-found"}], "wire": "3.5.1"}},
    {"request": {"op": "rename", "root": 0, "from": "../x", "to": "saves/x"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "rename", "root": 0, "from": "data/a.esp", "to": "../x"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 1, "from": "../x", "to": "x"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 1, "from": "data/a.esp", "to": "../x"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "stage-exec", "root": 0, "path": "../x"}, "expect": {"one_of": [{"status": "not-supported"}, {"status": "bad-request"}, {"status": "not-found"}], "wire": "3.5.1"}},
    {"request": {"op": "getattr", "root": 0, "path": ".."}, "expect": {"one_of": [{"status": "bad-request"}, {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}], "wire": "3.5.1"}},
    {"request": {"op": "readdir", "root": 0, "path": ".."}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "not-found"}], "wire": "3.5.1"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": ".."}, "expect": {"status": "bad-request"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": ".."}, "expect": {"status": "bad-request"}, "note": "a write open that creates"},
    {"request": {"op": "delete", "root": 0, "path": ".."}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "not-found"}], "wire": "3.5.1"}},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": ".."}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "not-found"}], "wire": "3.5.1"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": ".."}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "not-found"}], "wire": "3.5.1"}},
    {"request": {"op": "rename", "root": 0, "from": "..", "to": "saves/x"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "rename", "root": 0, "from": "data/a.esp", "to": ".."}, "expect": {"status": "bad-request"}},
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 1, "from": "..", "to": "x"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 1, "from": "data/a.esp", "to": ".."}, "expect": {"status": "bad-request"}},
    {"request": {"op": "stage-exec", "root": 0, "path": ".."}, "expect": {"one_of": [{"status": "not-supported"}, {"status": "bad-request"}, {"status": "not-found"}], "wire": "3.5.1"}},
    {"request": {"op": "getattr", "root": 0, "path": "../../x/y"}, "expect": {"one_of": [{"status": "bad-request"}, {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}], "wire": "3.5.1"}},
    {"request": {"op": "readdir", "root": 0, "path": "../../x/y"}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "not-found"}], "wire": "3.5.1"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "../../x/y"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "../../x/y"}, "expect": {"status": "bad-request"}, "note": "a write open that creates"},
    {"request": {"op": "delete", "root": 0, "path": "../../x/y"}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "not-found"}], "wire": "3.5.1"}},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "../../x/y"}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "not-found"}], "wire": "3.5.1"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "../../x/y"}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "not-found"}], "wire": "3.5.1"}},
    {"request": {"op": "rename", "root": 0, "from": "../../x/y", "to": "saves/x"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "rename", "root": 0, "from": "data/a.esp", "to": "../../x/y"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 1, "from": "../../x/y", "to": "x"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 1, "from": "data/a.esp", "to": "../../x/y"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "stage-exec", "root": 0, "path": "../../x/y"}, "expect": {"one_of": [{"status": "not-supported"}, {"status": "bad-request"}, {"status": "not-found"}], "wire": "3.5.1"}},
    {"request": {"op": "getattr", "root": 0, "path": "data/a.esp"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 3, "mtime": 0}}, "note": "nothing was moved or removed"},
    {"request": {"op": "getattr", "root": 0, "path": "secret.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 3, "mtime": 0}}}
  ]
}
