{
  "name": "getattr-files",
  "description": "GETATTR of a mounted file reports found and its size (wire.md 3.4.1: 18-byte reply with `found`, `is_dir`, `size`); an empty file has size 0; a file in a nested directory is found.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "data/a.esp", "contents": "abc"},
        {"path": "data/deep/er/b.bsa", "contents": {"size": 4096, "seed": 1}},
        {"path": "empty.txt", "contents": ""}
      ]}
    ]
  },
  "steps": [
    {"request": {"op": "getattr", "root": 0, "path": "data/a.esp"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 3, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "data/deep/er/b.bsa"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 4096, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "empty.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 0, "mtime": 0}}}
  ]
}
