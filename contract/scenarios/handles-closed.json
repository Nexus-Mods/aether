{
  "name": "handles-closed",
  "description": "A closed handle is unknown: every use of it is ST_BAD_FH, a second CLOSE included (wire.md 3.4.10: \"Unknown `fh` `ST_BAD_FH`\"); the file and its other handles are unharmed. After a CLOSE the director may reissue the number; the run sends the number the director closed, so this tests that handle.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [{"path": "w/a.txt", "contents": "abc"}],
       "writable": ["w"]}
    ]
  },
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["read", "write"], "path": "w/a.txt"}, "expect": {"reply": {"fh": 1, "size": 3, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "w/a.txt"}, "expect": {"reply": {"fh": 2, "size": 3, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 3}, "expect": {"status": "bad-fh"}},
    {"request": {"op": "write", "fh": 1, "offset": 0, "data": "z"}, "expect": {"status": "bad-fh"}},
    {"request": {"op": "setattr", "fh": 1, "size": 0}, "expect": {"status": "bad-fh"}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "bad-fh"}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 3}, "expect": {"reply": {"data": "abc"}}, "note": "the other handle still reads"},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 3}, "expect": {"status": "bad-fh"}}
  ]
}
