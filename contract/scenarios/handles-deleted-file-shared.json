{
  "name": "handles-deleted-file-shared",
  "description": "Two handles on one file, then the file deleted: a director either fails their READs, WRITEs and SETATTRs, or keeps the file for them, one file to both, so a WRITE or SETATTR through one is read through the other (wire.md 3.4.8: \"A kept file is still one file to all of them\"; 3.4.4), and nothing reaches it by its name: a file created there is another file. Their CLOSEs are ST_OK.",
  "tree": {"roots": [{"id": 0, "files": [{"path": "saves/a.txt", "contents": "old!"}], "writable": ["saves"]}]},
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["read", "write"], "path": "saves/a.txt"}, "expect": {"reply": {"fh": 1, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "open", "root": 0, "flags": ["read", "write"], "path": "saves/a.txt"}, "expect": {"reply": {"fh": 2, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "delete", "root": 0, "path": "saves/a.txt"}, "expect": {"status": "ok"}},
    {"request": {"op": "write", "fh": 1, "offset": 0, "data": "NEW"}, "expect": {"one_of": [{"reply": {"written": 3}}, {"status": "io-error"}, {"status": "not-found"}], "wire": "3.4.8"}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 16}, "expect": {"one_of": [{"reply": {"data": "NEW!"}}, {"status": "io-error"}, {"status": "not-found"}], "wire": "3.4.8"}, "note": "wire.md 3.4.8: the kept file, with the WRITE through the other handle, or a failure; never its own copy"},
    {"request": {"op": "setattr", "fh": 2, "size": 2}, "expect": {"one_of": [{"status": "ok"}, {"status": "io-error"}, {"status": "not-found"}], "wire": "3.4.8"}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"one_of": [{"reply": {"data": "NE"}}, {"status": "io-error"}, {"status": "not-found"}], "wire": "3.4.8"}, "note": "wire.md 3.4.8: the SETATTR through the other handle"},
    {"request": {"op": "getattr", "root": 0, "path": "saves/a.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}, "note": "wire.md 3.4.8: a kept file has no name"},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": []}}},
    {"request": {"op": "open", "root": 0, "flags": ["read", "write", "create"], "path": "saves/a.txt"}, "expect": {"reply": {"fh": 3, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}, "note": "wire.md 3.4.8: a new file at the name"},
    {"request": {"op": "write", "fh": 3, "offset": 0, "data": "fresh"}, "expect": {"reply": {"written": 5}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"one_of": [{"reply": {"data": "NE"}}, {"status": "io-error"}, {"status": "not-found"}], "wire": "3.4.8"}, "note": "wire.md 3.4.8: never the file created at the name later"},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "read", "fh": 3, "offset": 0, "len": 16}, "expect": {"reply": {"data": "fresh"}}, "note": "wire.md 3.4.8: the gone handles changed nothing at the name"},
    {"request": {"op": "close", "fh": 3}, "expect": {"status": "ok"}}
  ]
}
