{
  "name": "handles-deleted-file",
  "description": "A file deleted while a handle is open on it, and a new file created at its name: the old handle may read the deleted file's last bytes or fail, its WRITE and SETATTR change nothing anyone else sees, it never reaches the new file, and its CLOSE is ST_OK (wire.md 3.4.8). The name is free at once (3.4.8: \"A file with open handles is deleted like any other\").",
  "tree": {
    "roots": [
      {"id": 0, "files": [{"path": "saves/a.txt", "contents": "old!"}], "writable": ["saves"]}
    ]
  },
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["read", "write"], "path": "saves/a.txt"}, "expect": {"reply": {"fh": 1, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 1, "offset": 4, "data": "more"}, "expect": {"reply": {"written": 4}}},
    {"request": {"op": "delete", "root": 0, "path": "saves/a.txt"}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/a.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": []}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/a.txt"}, "expect": {"status": "not-found"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create", "excl"], "path": "saves/A.txt"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}, "note": "the name is free while fh 1 is open"},
    {"request": {"op": "write", "fh": 2, "offset": 0, "data": "new"}, "expect": {"reply": {"written": 3}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"one_of": [{"reply": {"data": "old!more"}}, {"status": "io-error"}, {"status": "not-found"}], "wire": "3.4.8"}, "note": "the deleted file's last bytes, or a failure; never the new file"},
    {"request": {"op": "write", "fh": 1, "offset": 0, "data": "Z"}, "expect": {"one_of": [{"reply": {"written": 1}}, {"status": "io-error"}, {"status": "not-found"}], "wire": "3.4.8"}},
    {"request": {"op": "setattr", "fh": 1, "size": 0}, "expect": {"one_of": [{"status": "ok"}, {"status": "io-error"}, {"status": "not-found"}], "wire": "3.4.8"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/a.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 3, "mtime": 0}}, "note": "the new file is untouched"},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 16}, "expect": {"reply": {"data": "new"}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/a.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 3, "mtime": 0}}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "A.txt", "is_dir": false, "size": 3, "mtime": 0}]}}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "saves/a.txt"}, "expect": {"reply": {"names": "saves/A.txt"}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/a.txt"}, "expect": {"reply": {"fh": 3, "size": 3, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 3, "offset": 0, "len": 16}, "expect": {"reply": {"data": "new"}}},
    {"request": {"op": "close", "fh": 3}, "expect": {"status": "ok"}}
  ]
}
