{
  "name": "handles-dir",
  "description": "A directory opens with size 0, is_dir set and immutable clear (wire.md 3.4.3: \"The `size` of a directory is 0\"; \"Never set it for a write open or a directory\"), and GETATTR of it says the same (3.4.1). A file operation on that handle is ST_IS_DIR (3.4.4: \"a directory handle `ST_IS_DIR`\"; 3.4.5: a WRITE or SETATTR on a directory handle is `ST_IS_DIR`, whatever access it was opened with; 3.5): READ, inline and bulk, WRITE and SETATTR. CLOSE releases it, and a use after that is ST_BAD_FH.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "data/a.esp", "contents": "abc"},
        {"path": "data/sub/b.txt", "contents": "b"}
      ],
       "writable": ["."]}
    ]
  },
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "data"}, "expect": {"reply": {"fh": 1, "size": 0, "is_dir": true, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"status": "is-dir"}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16, "slot_flags": ["read_bulk"]}, "expect": {"status": "is-dir"}},
    {"request": {"op": "write", "fh": 1, "offset": 0, "data": "x"}, "expect": {"status": "is-dir"}, "note": "3.4.5: a WRITE on a directory handle"},
    {"request": {"op": "setattr", "fh": 1, "size": 0}, "expect": {"status": "is-dir"}, "note": "3.4.5: so is SETATTR"},
    {"request": {"op": "getattr", "root": 0, "path": "data"}, "expect": {"reply": {"found": true, "is_dir": true, "size": 0, "mtime": 0}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "data/a.esp"}, "expect": {"reply": {"fh": 2, "size": 3, "is_dir": false, "immutable": false, "mount_gen": 0}}, "note": "the file's handle is unaffected"},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 8}, "expect": {"reply": {"data": "abc"}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"status": "bad-fh"}},
    {"request": {"op": "readdir", "root": 0, "path": "data"}, "expect": {"reply": {"entries": [{"name": "a.esp", "is_dir": false, "size": 3, "mtime": 0}, {"name": "sub", "is_dir": true, "size": 0, "mtime": 0}]}}}
  ]
}
