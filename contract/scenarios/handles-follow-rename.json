{
  "name": "handles-follow-rename",
  "description": "A handle follows its file through a RENAME, its own or a directory's above it, and never reaches a file later created at the old name (wire.md 3.4.7: \"Its handles follow it\"): the save pattern writes a temporary file, renames it over the target and writes again through the same handle. A handle on the file the rename replaced may read its last bytes or fail (3.4.8). A file onto an empty directory may replace it or be refused (3.4.7).",
  "tree": {
    "roots": [
      {"id": 0, "files": [{"path": "saves/final.sav", "contents": "OLD"}, {"path": "saves/a.txt", "contents": "AAAA"}, {"path": "saves/dir/sub/f.txt", "contents": "abc"}], "dirs": ["saves/e"], "writable": ["saves"]}
    ]
  },
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "saves/final.tmp"}, "expect": {"reply": {"fh": 1, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 1, "offset": 0, "data": "NEWDATA"}, "expect": {"reply": {"written": 7}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/final.sav"}, "expect": {"reply": {"fh": 2, "size": 3, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 16}, "expect": {"reply": {"data": "OLD"}}},
    {"request": {"op": "rename", "root": 0, "from": "saves/final.tmp", "to": "saves/Final.sav"}, "expect": {"status": "ok"}, "note": "both ends have open handles"},
    {"request": {"op": "getattr", "root": 0, "path": "saves/final.tmp"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/final.sav"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 7, "mtime": 0}}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "a.txt", "is_dir": false, "size": 4, "mtime": 0}, {"name": "dir", "is_dir": true, "size": 0, "mtime": 0}, {"name": "e", "is_dir": true, "size": 0, "mtime": 0}, {"name": "Final.sav", "is_dir": false, "size": 7, "mtime": 0}]}}},
    {"request": {"op": "write", "fh": 1, "offset": 7, "data": "!"}, "expect": {"reply": {"written": 1}}, "note": "fh 1 follows its file to its new name"},
    {"request": {"op": "getattr", "root": 0, "path": "saves/final.sav"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 8, "mtime": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"reply": {"data": "NEWDATA!"}}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 16}, "expect": {"one_of": [{"reply": {"data": "OLD"}}, {"status": "io-error"}, {"status": "not-found"}], "wire": "3.4.8"}, "note": "the file the rename replaced: its last bytes, or a failure"},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/FINAL.SAV"}, "expect": {"reply": {"fh": 3, "size": 8, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 3, "offset": 0, "len": 16}, "expect": {"reply": {"data": "NEWDATA!"}}},
    {"request": {"op": "close", "fh": 3}, "expect": {"status": "ok"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 1, "path": "saves/final.sav"}, "expect": {"reply": {"names": "Final.sav"}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/a.txt"}, "expect": {"reply": {"fh": 4, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "rename", "root": 0, "from": "saves/a.txt", "to": "saves/b.txt"}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/a.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "read", "fh": 4, "offset": 0, "len": 16}, "expect": {"reply": {"data": "AAAA"}}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create", "excl"], "path": "saves/a.txt"}, "expect": {"reply": {"fh": 5, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 5, "offset": 0, "data": "zz"}, "expect": {"reply": {"written": 2}}},
    {"request": {"op": "read", "fh": 4, "offset": 0, "len": 16}, "expect": {"reply": {"data": "AAAA"}}, "note": "fh 4 follows b.txt, not the new a.txt"},
    {"request": {"op": "close", "fh": 4}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/a.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 2, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/b.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 4, "mtime": 0}}},
    {"request": {"op": "close", "fh": 5}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/dir/sub/f.txt"}, "expect": {"reply": {"fh": 6, "size": 3, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "rename", "root": 0, "from": "saves/dir", "to": "saves/Moved"}, "expect": {"status": "ok"}},
    {"request": {"op": "read", "fh": 6, "offset": 0, "len": 16}, "expect": {"reply": {"data": "abc"}}, "note": "a file under a renamed directory"},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "saves/dir"}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves/dir"}, "expect": {"reply": {"entries": []}}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "saves/dir/sub2"}, "expect": {"reply": {"fh": 7, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 6, "offset": 0, "len": 16}, "expect": {"reply": {"data": "abc"}}},
    {"request": {"op": "close", "fh": 6}, "expect": {"status": "ok"}},
    {"request": {"op": "close", "fh": 7}, "expect": {"status": "ok"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "saves/moved/sub/f.txt"}, "expect": {"reply": {"names": "saves/Moved/sub/f.txt"}}},
    {"request": {"op": "rename", "root": 0, "from": "saves/final.sav", "to": "saves/e"}, "expect": {"one_of": [{"status": "ok"}, {"status": "io-error"}], "wire": "3.4.7"}, "note": "a file onto an empty directory; the last step, since what follows would depend on it"}
  ]
}
