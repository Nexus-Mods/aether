{
  "name": "mkdir-child-rename-parent",
  "description": "A directory made by MKDIR, with a file and a subdirectory made in it, renamed: its children move with it, and a directory made again at the old name is empty (wire.md 3.4.7: \"a directory moves with everything under it\"; 3.4.9). Names are matched by fold and keep the spelling they were created with (3.2).",
  "tree": {
    "roots": [
      {"id": 0, "writable": ["saves"]}
    ]
  },
  "steps": [
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "saves/New Dir"}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "saves/new dir/File.txt"}, "expect": {"reply": {"fh": 1, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 1, "offset": 0, "data": "hi"}, "expect": {"reply": {"written": 2}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "saves/New Dir/Sub"}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "saves/new dir/sub/d"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 2, "offset": 0, "data": "dd"}, "expect": {"reply": {"written": 2}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "rename", "root": 0, "from": "saves/NEW DIR", "to": "saves/Renamed"}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "Renamed", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "readdir", "root": 0, "path": "saves/renamed"}, "expect": {"reply": {"entries": [{"name": "File.txt", "is_dir": false, "size": 2, "mtime": 0}, {"name": "Sub", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "stored-names", "root": 0, "skip": 1, "path": "saves/renamed/file.txt"}, "expect": {"reply": {"names": "Renamed/File.txt"}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/new dir/file.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "saves/New Dir"}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves/new dir"}, "expect": {"reply": {"entries": []}}, "note": "nothing of the renamed directory's is left under its old name"},
    {"request": {"op": "getattr", "root": 0, "path": "saves/new dir/sub/d"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "delete", "root": 0, "path": "saves/renamed"}, "expect": {"status": "io-error"}},
    {"request": {"op": "delete", "root": 0, "path": "saves/renamed/sub/d"}, "expect": {"status": "ok"}},
    {"request": {"op": "delete", "root": 0, "path": "saves/renamed/sub"}, "expect": {"status": "ok"}},
    {"request": {"op": "delete", "root": 0, "path": "saves/renamed/file.txt"}, "expect": {"status": "ok"}},
    {"request": {"op": "delete", "root": 0, "path": "saves/renamed"}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "New Dir", "is_dir": true, "size": 0, "mtime": 0}]}}}
  ]
}
