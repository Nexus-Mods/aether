{
  "name": "mkdir-create",
  "description": "MKDIR creates a directory under a writable provider (wire.md 3.4.9); it lists, in its parent, as a directory of size 0 (3.4.2), and is a place a file can then be created in. The mode is ignored.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [{"path": "data/a.esp", "contents": "abc"}],
       "dirs": ["saves"],
       "writable": ["saves"]}
    ]
  },
  "steps": [
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "saves/new"}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "new", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "saves/new/file.txt"}, "expect": {"reply": {"fh": 1, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 1, "offset": 0, "data": "in"}, "expect": {"reply": {"written": 2}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves/new"}, "expect": {"reply": {"entries": [{"name": "file.txt", "is_dir": false, "size": 2, "mtime": 0}]}}},
    {"request": {"op": "mkdir", "root": 0, "mode": 0, "path": "saves/mode0"}, "expect": {"status": "ok"}, "note": "the mode is ignored"},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "mode0", "is_dir": true, "size": 0, "mtime": 0}, {"name": "new", "is_dir": true, "size": 0, "mtime": 0}]}}}
  ]
}
