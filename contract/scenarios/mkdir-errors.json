{
  "name": "mkdir-errors",
  "description": "MKDIR refusals: a root with no writable provider is ST_READ_ONLY (wire.md 3.5, 3.4.3); an unknown root is ST_NOT_FOUND (3.5.1).",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [{"path": "data/a.esp", "contents": "abc"}],
       "dirs": ["data/sub"]}
    ]
  },
  "steps": [
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "newdir"}, "expect": {"status": "read-only"}},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "data/newdir"}, "expect": {"status": "read-only"}},
    {"request": {"op": "mkdir", "root": 3, "mode": 493, "path": "newdir"}, "expect": {"status": "not-found"}, "note": "root 3 is not served"},
    {"request": {"op": "readdir", "root": 0, "path": "."}, "expect": {"reply": {"entries": [{"name": "data", "is_dir": true, "size": 0, "mtime": 0}]}}}
  ]
}
