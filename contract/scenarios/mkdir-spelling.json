{
  "name": "mkdir-spelling",
  "description": "A directory is stored with the caller's spelling (wire.md 3.2, 3.4.9), found under the fold, and STORED_NAMES and READDIR answer with the stored spelling.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [],
       "dirs": ["saves"],
       "writable": ["saves"]}
    ]
  },
  "steps": [
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "saves/My Games"}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "My Games", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "stored-names", "root": 0, "skip": 1, "path": "saves/my games"}, "expect": {"reply": {"names": "My Games"}}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "saves/MY GAMES/Slot.1"}, "expect": {"reply": {"fh": 1, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}, "note": "a file made through another case of the directory"},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "saves/my games/slot.1"}, "expect": {"reply": {"names": "saves/My Games/Slot.1"}}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "My Games", "is_dir": true, "size": 0, "mtime": 0}]}}}
  ]
}
