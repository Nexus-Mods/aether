{
  "name": "names-non-bmp",
  "description": "Names with characters outside the Basic Multilingual Plane (four UTF-8 bytes, a UTF-16 surrogate pair) are names like any other (wire.md 3.2: paths are UTF-8, compared by the fold, stored with the caller's spelling): read from the tree, created, listed, respelled through STORED_NAMES and renamed. None of them has a case, so no file system's case rules come in.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [{"path": "Mods/🐉 Dragons/𝔄rt.esp", "contents": "dragon"}],
       "writable": ["saves"]}
    ]
  },
  "steps": [
    {"request": {"op": "getattr", "root": 0, "path": "mods/🐉 dragons/𝔄rt.esp"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 6, "mtime": 0}}},
    {"request": {"op": "readdir", "root": 0, "path": "mods"}, "expect": {"reply": {"entries": [{"name": "🐉 Dragons", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "mods/🐉 dragons/𝔄rt.esp"}, "expect": {"reply": {"names": "Mods/🐉 Dragons/𝔄rt.esp"}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "mods/🐉 dragons/𝔄rt.esp"}, "expect": {"reply": {"fh": 1, "size": 6, "is_dir": false, "immutable": true, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 64}, "expect": {"reply": {"data": "dragon"}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["read", "write", "create"], "path": "saves/🎮 Slot 1.sav"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 2, "offset": 0, "data": "save"}, "expect": {"reply": {"written": 4}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "saves/𓂀"}, "expect": {"status": "ok"}},
    {"request": {"op": "rename", "root": 0, "from": "saves/🎮 slot 1.sav", "to": "saves/𓂀/🎮 Slot 2.sav"}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves/𓂀"}, "expect": {"reply": {"entries": [{"name": "🎮 Slot 2.sav", "is_dir": false, "size": 4, "mtime": 0}]}}},
    {"request": {"op": "stored-names", "root": 0, "skip": 1, "path": "saves/𓂀/🎮 slot 2.sav"}, "expect": {"reply": {"names": "𓂀/🎮 Slot 2.sav"}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/🎮 slot 1.sav"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}}
  ]
}
