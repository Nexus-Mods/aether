{
  "name": "open-read",
  "description": "OPEN of a mounted file for reading replies with a handle, the file's size, is_dir=false (wire.md 3.4.3, 24-byte reply); two handles to one file are independent, each its own handle. `fh` is any u64 the director chooses, unique among open handles (3.4.3).",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "data/a.esp", "contents": "abc"},
        {"path": "data/big.bsa", "contents": {"size": 5000, "seed": 2}},
        {"path": "Data/Mixed.TXT", "contents": "mixed"}
      ]}
    ]
  },
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "data/a.esp"}, "expect": {"reply": {"fh": 1, "size": 3, "is_dir": false, "immutable": true, "mount_gen": 0}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "data/a.esp"}, "expect": {"reply": {"fh": 2, "size": 3, "is_dir": false, "immutable": true, "mount_gen": 0}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "data/big.bsa"}, "expect": {"reply": {"fh": 3, "size": 5000, "is_dir": false, "immutable": true, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"reply": {"data": "abc"}}},
    {"request": {"op": "read", "fh": 2, "offset": 1, "len": 16}, "expect": {"reply": {"data": "bc"}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 2}, "expect": {"reply": {"data": "ab"}}, "note": "the other handle is unaffected by the close"},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "close", "fh": 3}, "expect": {"status": "ok"}}
  ]
}
