{
  "name": "open-write-existing-readonly-path",
  "description": "OPEN_WRITE of an existing file outside every writable provider is ST_READ_ONLY (wire.md 3.5: \"No writable provider serves this path\"), in a root that has a writable provider elsewhere; the same file still reads.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "data/a.esp", "contents": "abc"},
        {"path": "saves/s.sav", "contents": "s"}
      ],
       "writable": ["saves"]}
    ]
  },
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["write"], "path": "data/a.esp"}, "expect": {"status": "read-only"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "trunc"], "path": "data/a.esp"}, "expect": {"status": "read-only"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "data/a.esp"}, "expect": {"reply": {"fh": 1, "size": 3, "is_dir": false, "immutable": true, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 3}, "expect": {"reply": {"data": "abc"}}, "note": "unchanged"},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}}
  ]
}
