{
  "name": "overlay-delete-dir",
  "description": "DELETE of a lower-only directory with children hides it and everything under it, a farther layer's names included (wire.md 3.4.9, \"Names only in a read-only lower\"); a handle on a file below it reads its last bytes or fails (3.4.8); the directory made again is empty, since what the DELETE hid stays hidden; a directory the upper holds with a lower's names under it is ST_IO_ERROR to DELETE (3.4.8: \"A directory with anything under it\").",
  "tree": {
    "roots": [
      {"id": 0, "writable": ["."], "files": [{"path": "Data/Keep.esp", "contents": "keep"}], "dirs": ["Data/Up"], "lower": [{"files": [{"path": "Data/Meshes/a.nif", "contents": "a"}, {"path": "Data/Meshes/Deep/b.nif", "contents": "b"}, {"path": "Data/Up/low.txt", "contents": "low"}]}, {"files": [{"path": "data/meshes/c.nif", "contents": "c"}]}]}
    ]
  },
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "data/meshes/deep/b.nif"}, "expect": {"reply": {"fh": 1, "size": 1, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "readdir", "root": 0, "path": "data/meshes"}, "expect": {"reply": {"entries": [{"name": "Deep", "is_dir": true, "size": 0, "mtime": 0}, {"name": "a.nif", "is_dir": false, "size": 1, "mtime": 0}, {"name": "c.nif", "is_dir": false, "size": 1, "mtime": 0}]}}},
    {"request": {"op": "delete", "root": 0, "path": "data/meshes"}, "expect": {"status": "ok"}, "note": "children and all"},
    {"request": {"op": "getattr", "root": 0, "path": "data/meshes"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "data/meshes/deep/b.nif"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "data/meshes/c.nif"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}, "note": "the farther layer's too"},
    {"request": {"op": "readdir", "root": 0, "path": "data"}, "expect": {"reply": {"entries": [{"name": "Keep.esp", "is_dir": false, "size": 4, "mtime": 0}, {"name": "Up", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 64}, "expect": {"one_of": [{"reply": {"data": "b"}}, {"status": "io-error"}, {"status": "not-found"}], "wire": "3.4.8"}},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "Data/meshes"}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "data/meshes"}, "expect": {"reply": {"entries": []}}, "note": "made again: empty"},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "data/meshes/a.nif"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}, "note": "a new file, not the lower's"},
    {"request": {"op": "getattr", "root": 0, "path": "data/meshes/c.nif"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "delete", "root": 0, "path": "data/up"}, "expect": {"status": "io-error"}, "note": "an upper directory whose only child is a lower's"},
    {"request": {"op": "readdir", "root": 0, "path": "data/up"}, "expect": {"reply": {"entries": [{"name": "low.txt", "is_dir": false, "size": 3, "mtime": 0}]}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}}
  ]
}
