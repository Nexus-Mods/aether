{
  "name": "overlay-written-file",
  "description": "A lower-only file whose bytes a WRITE or a truncating OPEN changed is held by the writable provider: the lower is read-only (wire.md 3.4.9, \"Names only in a read-only lower\": \"a writable upper over a read-only lower\"), so the changed file is the upper's. MKDIR over it is then ST_IO_ERROR and a case-only RENAME respells it (3.4.7, 3.4.9), where for a file still only in the lower MKDIR makes a directory and a case-only RENAME keeps the lower's spelling (3.4.9).",
  "tree": {
    "roots": [
      {"id": 0, "writable": ["."], "files": [{"path": "Data/Keep.esp", "contents": "keep"}], "lower": [{"files": [{"path": "Data/Mod.esp", "contents": "mod"}, {"path": "Data/Two.esp", "contents": "two"}, {"path": "Data/Three.esp", "contents": "three"}]}]}
    ]
  },
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["write"], "path": "data/mod.esp"}, "expect": {"reply": {"fh": 1, "size": 3, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 1, "offset": 3, "data": "!"}, "expect": {"reply": {"written": 1}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "data/mod.esp"}, "expect": {"status": "io-error"}, "note": "a written file is the upper's"},
    {"request": {"op": "rename", "root": 0, "from": "data/mod.esp", "to": "Data/MOD.esp"}, "expect": {"status": "ok"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "data/mod.esp"}, "expect": {"reply": {"names": "Data/MOD.esp"}}, "note": "respelled"},
    {"request": {"op": "open", "root": 0, "flags": ["write", "trunc"], "path": "data/two.esp"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "data/two.esp"}, "expect": {"status": "io-error"}, "note": "a truncated file is the upper's"},
    {"request": {"op": "rename", "root": 0, "from": "data/three.esp", "to": "Data/THREE.esp"}, "expect": {"status": "ok"}, "note": "a lower-only file"},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "data/three.esp"}, "expect": {"reply": {"names": "Data/Three.esp"}}, "note": "the lower's spelling kept"},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "Data/Three.esp"}, "expect": {"status": "ok"}, "note": "a lower-only file: hidden by the directory"},
    {"request": {"op": "readdir", "root": 0, "path": "data"}, "expect": {"reply": {"entries": [{"name": "Keep.esp", "is_dir": false, "size": 4, "mtime": 0}, {"name": "MOD.esp", "is_dir": false, "size": 4, "mtime": 0}, {"name": "Three.esp", "is_dir": true, "size": 0, "mtime": 0}, {"name": "Two.esp", "is_dir": false, "size": 0, "mtime": 0}]}}}
  ]
}
