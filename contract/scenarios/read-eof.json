{
  "name": "read-eof",
  "description": "READ at the end of the file, and beyond it, returns no bytes: \"`n < len` means end of file; the shim stops there\" (wire.md 3.4.4), so n=0 (ST_OK, empty data) when the whole range is past the end. An empty file reads as empty.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "a.txt", "contents": "0123456789"},
        {"path": "empty.txt", "contents": ""}
      ]}
    ]
  },
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "a.txt"}, "expect": {"reply": {"fh": 1, "size": 10, "is_dir": false, "immutable": true, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 10, "len": 4}, "expect": {"reply": {"data": ""}}, "note": "offset == size"},
    {"request": {"op": "read", "fh": 1, "offset": 11, "len": 4}, "expect": {"reply": {"data": ""}}, "note": "offset just past the end"},
    {"request": {"op": "read", "fh": 1, "offset": 4096, "len": 4}, "expect": {"reply": {"data": ""}}, "note": "offset far past the end"},
    {"request": {"op": "read", "fh": 1, "offset": 10, "len": 4, "slot_flags": ["read_bulk"]}, "expect": {"reply": {"data": ""}}, "note": "the same through the bulk path (the reply is compared by data)"},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "empty.txt"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": false, "immutable": true, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 16}, "expect": {"reply": {"data": ""}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}}
  ]
}
