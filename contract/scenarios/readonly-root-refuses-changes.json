{
  "name": "readonly-root-refuses-changes",
  "description": "A root with no writable provider refuses every change with ST_READ_ONLY (wire.md 3.5: \"No writable provider serves this path\"): DELETE of a file and of a directory (3.4.8: \"a path outside every writable provider `ST_READ_ONLY`\"), RENAME (3.4.7: \"either end outside every writable provider `ST_READ_ONLY`\") and RENAME_X between equal roots (3.4.13: \"Equal roots behave as RENAME\"); SETATTR on a directory handle is ST_IS_DIR or ST_READ_ONLY (3.4.5: \"A directory no writable provider holds may answer `ST_READ_ONLY` instead\"). Nothing changes: the file still reads the same through the handle opened first. SETATTR or WRITE through a read handle on a file is not sent, since wire.md fixes no answer for it; write opens are in open-errors, MKDIR in mkdir-errors.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "data/a.esp", "contents": "abc"}
       ],
       "dirs": ["data/sub"]}
    ]
  },
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "data/a.esp"}, "expect": {"reply": {"fh": 1, "size": 3, "is_dir": false, "immutable": true, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"reply": {"data": "abc"}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "data/sub"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": true, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "setattr", "fh": 2, "size": 0}, "expect": {"one_of": [{"status": "is-dir"}, {"status": "read-only"}], "wire": "3.4.5"}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "delete", "root": 0, "path": "data/a.esp"}, "expect": {"status": "read-only"}},
    {"request": {"op": "delete", "root": 0, "path": "data/sub"}, "expect": {"status": "read-only"}, "note": "an empty directory"},
    {"request": {"op": "rename", "root": 0, "from": "data/a.esp", "to": "data/b.esp"}, "expect": {"status": "read-only"}},
    {"request": {"op": "rename", "root": 0, "from": "data/sub", "to": "data/sub2"}, "expect": {"status": "read-only"}, "note": "a directory"},
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 0, "from": "data/a.esp", "to": "data/c.esp"}, "expect": {"status": "read-only"}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"reply": {"data": "abc"}}, "note": "unchanged"},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "data/a.esp"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 3, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "data/sub"}, "expect": {"reply": {"found": true, "is_dir": true, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "data/b.esp"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "data/c.esp"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "data/sub2"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}}
  ]
}
