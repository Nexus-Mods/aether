    {"request": {"op": "reg-rename-key", "path": "\\Registry\\\\Machine", "new_leaf": "x"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-changed", "path": "\\Registry\\\\Machine", "subtree": true, "since": 0}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-key", "path": "\\Registry\\Machine\\Software\\Cairn\\"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-set-value", "path": "\\Registry\\Machine\\Software\\Cairn\\", "name": "v", "ty": 4, "data": {"hex": "01000000"}}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-delete-value", "path": "\\Registry\\Machine\\Software\\Cairn\\", "name": "v"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-create-key", "path": "\\Registry\\Machine\\Software\\Cairn\\", "volatile": false}, "expect": {"status": "bad-request"}},
