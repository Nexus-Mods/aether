    {"request": {"op": "reg-changed", "path": "Registry\\Machine\\Software\\Cairn", "subtree": true, "since": 0}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-key", "path": "\\Machine\\Software"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-set-value", "path": "\\Machine\\Software", "name": "v", "ty": 4, "data": {"hex": "01000000"}}, "expect": {"status": "bad-request"}},
