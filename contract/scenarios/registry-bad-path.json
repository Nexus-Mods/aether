{
  "name": "registry-bad-path",
  "description": "A key path that is not canonical is ST_BAD_REQUEST (wire.md 4.2: \"A director must answer `ST_BAD_REQUEST` for a path that is not canonical\"): no leading `\\`, not under `\\Registry`, an empty component, a trailing `\\`, a `.` or `..` component, an empty path. Every registry opcode checks it, and nothing is written.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [{"path": "a.txt", "contents": "a"}]}
    ],
    "registry": {"keys": [
      {"path": "\\Registry\\Machine\\Software\\Cairn"}
    ]}
  },
  "steps": [
    {"request": {"op": "reg-lookup", "path": ""}, "expect": {"status": "bad-request"}, "note": "path ''"},
    {"request": {"op": "reg-lookup", "path": "\\"}, "expect": {"status": "bad-request"}, "note": "path '\\\\'"},
    {"request": {"op": "reg-lookup", "path": "Registry\\Machine\\Software\\Cairn"}, "expect": {"status": "bad-request"}, "note": "path 'Registry\\\\Machine\\\\Software\\\\Cairn'"},
    {"request": {"op": "reg-lookup", "path": "\\Machine\\Software"}, "expect": {"status": "bad-request"}, "note": "path '\\\\Machine\\\\Software'"},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\\\Machine"}, "expect": {"status": "bad-request"}, "note": "path '\\\\Registry\\\\\\\\Machine'"},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\Cairn\\"}, "expect": {"status": "bad-request"}, "note": "path '\\\\Registry\\\\Machine\\\\Software\\\\Cairn\\\\'"},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\."}, "expect": {"status": "bad-request"}, "note": "path '\\\\Registry\\\\Machine\\\\.'"},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\..\\Software"}, "expect": {"status": "bad-request"}, "note": "path '\\\\Registry\\\\Machine\\\\..\\\\Software'"},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\.\\Cairn"}, "expect": {"status": "bad-request"}, "note": "path '\\\\Registry\\\\Machine\\\\Software\\\\.\\\\Cairn'"},
    {"request": {"op": "reg-lookup", "path": "/Registry/Machine/Software/Cairn"}, "expect": {"status": "bad-request"}, "note": "path '/Registry/Machine/Software/Cairn'"},
    {"request": {"op": "reg-key", "path": ""}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-set-value", "path": "", "name": "v", "ty": 4, "data": {"hex": "01000000"}}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-delete-value", "path": "", "name": "v"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-create-key", "path": "", "volatile": false}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-delete-key", "path": ""}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-rename-key", "path": "", "new_leaf": "x"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-changed", "path": "", "subtree": true, "since": 0}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-key", "path": "\\"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-set-value", "path": "\\", "name": "v", "ty": 4, "data": {"hex": "01000000"}}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-delete-value", "path": "\\", "name": "v"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-create-key", "path": "\\", "volatile": false}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-delete-key", "path": "\\"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-rename-key", "path": "\\", "new_leaf": "x"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-changed", "path": "\\", "subtree": true, "since": 0}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-key", "path": "Registry\\Machine\\Software\\Cairn"}, "expect": {"status": "bad-request"}},
