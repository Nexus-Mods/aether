    {"request": {"op": "reg-changed", "path": "\\Machine\\Software", "subtree": true, "since": 0}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-key", "path": "\\Registry\\\\Machine"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-set-value", "path": "\\Registry\\\\Machine", "name": "v", "ty": 4, "data": {"hex": "01000000"}}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-delete-value", "path": "\\Registry\\\\Machine", "name": "v"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-create-key", "path": "\\Registry\\\\Machine", "volatile": false}, "expect": {"status": "bad-request"}},
