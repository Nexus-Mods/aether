    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cairn\\", "subtree": true, "since": 0}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\Cairn"}, "expect": {"reply": {"version": 1, "state": "created", "below": false}}, "note": "nothing changed: the version is the mount's"}
  ]
