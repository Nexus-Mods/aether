{
  "name": "registry-changed",
  "description": "REG_CHANGED says whether a key changed after a version: its own values, existence or child list and, with `subtree`, anything below it; a deleted key counts as changed by its deletion or an ancestor's (wire.md 4.3). `since` is sent in the numbering of the director it goes to, except the shim's probe `since = u64::MAX`, which only asks for the current version and is sent as it is.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [{"path": "a.txt", "contents": "a"}]}
    ],
    "registry": {"keys": [
      {"path": "\\Registry\\Machine\\Software\\Cabin"},
      {"path": "\\Registry\\Machine\\Software\\Cabin\\Quiet\\Sub"}
    ]}
  },
  "steps": [
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin", "subtree": true, "since": 18446744073709551615}, "expect": {"reply": {"version": 2, "changed": false}}, "note": "the shim's probe for the current version (since = u64::MAX): nothing changed after every version, in any numbering"},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin", "subtree": true, "since": 2}, "expect": {"reply": {"version": 2, "changed": false}}, "note": "nothing since the mount"},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin\\Quiet", "subtree": true, "since": 2}, "expect": {"reply": {"version": 2, "changed": false}}},
    {"request": {"path": "\\Registry\\Machine\\Software\\Cabin\\Quiet\\Sub", "name": "v", "ty": 4, "data": {"hex": "01000000"}, "op": "reg-set-value"}, "expect": {"reply": {"version": 3}}},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin\\Quiet\\Sub", "subtree": false, "since": 18446744073709551615}, "expect": {"reply": {"version": 3, "changed": false}}, "note": "the probe again, with the session's version offset fixed: sent as it is (u64::MAX is not shifted), and still nothing after every version"},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin\\Quiet\\Sub", "subtree": false, "since": 2}, "expect": {"reply": {"version": 3, "changed": true}}},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin\\Quiet", "subtree": false, "since": 2}, "expect": {"reply": {"version": 3, "changed": false}}, "note": "its own values and child list did not change"},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin\\Quiet", "subtree": true, "since": 2}, "expect": {"reply": {"version": 3, "changed": true}}, "note": "but below it something did"},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin", "subtree": true, "since": 2}, "expect": {"reply": {"version": 3, "changed": true}}},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin\\Quiet\\Sub", "subtree": true, "since": 3}, "expect": {"reply": {"version": 3, "changed": false}}, "note": "since the very change"},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin", "subtree": true, "since": 3}, "expect": {"reply": {"version": 3, "changed": false}}},
    {"request": {"path": "\\Registry\\Machine\\Software\\Cabin", "name": "own", "ty": 4, "data": {"hex": "02000000"}, "op": "reg-set-value"}, "expect": {"reply": {"version": 4}}},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin", "subtree": false, "since": 3}, "expect": {"reply": {"version": 4, "changed": true}}},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin", "subtree": false, "since": 4}, "expect": {"reply": {"version": 4, "changed": false}}},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin\\Quiet", "subtree": true, "since": 3}, "expect": {"reply": {"version": 4, "changed": false}}},
    {"request": {"path": "\\Registry\\Machine\\Software\\Cabin\\Quiet", "op": "reg-delete-key"}, "expect": {"reply": {"version": 5}}},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin\\Quiet", "subtree": false, "since": 4}, "expect": {"reply": {"version": 5, "changed": true}}, "note": "a deleted key counts as changed"},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin\\Quiet\\Sub", "subtree": false, "since": 4}, "expect": {"reply": {"version": 5, "changed": true}}, "note": "and so does one below it"},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin\\Quiet", "subtree": false, "since": 5}, "expect": {"reply": {"version": 5, "changed": false}}},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin", "subtree": false, "since": 4}, "expect": {"reply": {"version": 5, "changed": true}}, "note": "its child list changed"},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Cabin\\Never", "subtree": true, "since": 5}, "expect": {"reply": {"version": 5, "changed": false}}, "note": "a key never held, nothing deleted since"}
  ]
}
