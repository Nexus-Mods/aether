{
  "name": "registry-key-lifecycle",
  "description": "A key's life in the overlay (wire.md 4.3): created, given values and a subkey with a value; renamed, after which the old name is tombstoned with its subtree and the new name holds the values and the subkey; looked up under both names and reported changed under both; deleted with its values and subkey, all of which read as tombstoned; created again empty, its old values and subkey gone (\"everything below it is dropped\"); deleted again, and a third delete ST_NOT_FOUND. Every write moves the version by one (4.3, \"Version\").",
  "tree": {"roots": [{"id": 0, "files": [{"path": "a.txt", "contents": "a"}]}], "registry": {"keys": [{"path": "\\Registry\\Machine\\Software\\Conform"}]}},
  "steps": [
    {"request": {"op": "reg-create-key", "path": "\\Registry\\Machine\\Software\\Conform\\Game", "volatile": false}, "expect": {"reply": {"version": 2}}},
    {"request": {"op": "reg-set-value", "path": "\\Registry\\Machine\\Software\\Conform\\Game", "name": "Name", "ty": 1, "data": {"hex": "78000000"}}, "expect": {"reply": {"version": 3}}},
    {"request": {"op": "reg-set-value", "path": "\\Registry\\Machine\\Software\\Conform\\Game", "name": "Level", "ty": 4, "data": {"hex": "05000000"}}, "expect": {"reply": {"version": 4}}},
    {"request": {"op": "reg-create-key", "path": "\\Registry\\Machine\\Software\\Conform\\Game\\Saves", "volatile": false}, "expect": {"reply": {"version": 5}}},
    {"request": {"op": "reg-set-value", "path": "\\Registry\\Machine\\Software\\Conform\\Game\\Saves", "name": "Slot", "ty": 4, "data": {"hex": "01000000"}}, "expect": {"reply": {"version": 6}}},
    {"request": {"op": "reg-key", "path": "\\Registry\\Machine\\Software\\Conform\\Game"}, "expect": {"reply": {"version": 6, "node": {"created": true, "volatile": false, "last_write": 0, "values": [{"name": "Name", "ty": 1, "data": {"hex": "78000000"}}, {"name": "Level", "ty": 4, "data": {"hex": "05000000"}}], "value_tombstones": [], "children": [{"folded": "saves", "spelling": "Saves", "state": "present"}]}}}},
    {"request": {"op": "reg-rename-key", "path": "\\Registry\\Machine\\Software\\Conform\\Game", "new_leaf": "Play"}, "expect": {"reply": {"version": 7}}},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\Conform\\Game"}, "expect": {"reply": {"version": 7, "state": "tombstoned", "below": false}}, "note": "wire.md 4.3: the old name is tombstoned in the parent"},
    {"request": {"op": "reg-key", "path": "\\Registry\\Machine\\Software\\Conform\\Game"}, "expect": {"reply": {"version": 7, "node": null}}},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\Conform\\Game\\Saves"}, "expect": {"reply": {"version": 7, "state": "tombstoned", "below": false}}, "note": "wire.md 4.3: below a tombstoned key"},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\Conform\\Play"}, "expect": {"reply": {"version": 7, "state": "created", "below": true}}, "note": "wire.md 4.3: every moved key created"},
    {"request": {"op": "reg-key", "path": "\\Registry\\Machine\\Software\\Conform\\Play"}, "expect": {"reply": {"version": 7, "node": {"created": true, "volatile": false, "last_write": 0, "values": [{"name": "Name", "ty": 1, "data": {"hex": "78000000"}}, {"name": "Level", "ty": 4, "data": {"hex": "05000000"}}], "value_tombstones": [], "children": [{"folded": "saves", "spelling": "Saves", "state": "present"}]}}}},
    {"request": {"op": "reg-key", "path": "\\Registry\\Machine\\Software\\Conform\\Play\\Saves"}, "expect": {"reply": {"version": 7, "node": {"created": true, "volatile": false, "last_write": 0, "values": [{"name": "Slot", "ty": 4, "data": {"hex": "01000000"}}], "value_tombstones": [], "children": []}}}},
    {"request": {"op": "reg-key", "path": "\\Registry\\Machine\\Software\\Conform"}, "expect": {"reply": {"version": 7, "node": {"created": true, "volatile": false, "last_write": 0, "values": [], "value_tombstones": [], "children": [{"folded": "game", "spelling": "Game", "state": "tombstone"}, {"folded": "play", "spelling": "Play", "state": "present"}]}}}},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Conform\\Game", "subtree": false, "since": 6}, "expect": {"reply": {"version": 7, "changed": true}}, "note": "wire.md 4.3: renamed away after `since`"},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Conform\\Play", "subtree": true, "since": 6}, "expect": {"reply": {"version": 7, "changed": true}}},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Conform\\Play", "subtree": true, "since": 7}, "expect": {"reply": {"version": 7, "changed": false}}},
    {"request": {"op": "reg-delete-key", "path": "\\Registry\\Machine\\Software\\Conform\\Play"}, "expect": {"reply": {"version": 8}}},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\Conform\\Play"}, "expect": {"reply": {"version": 8, "state": "tombstoned", "below": false}}},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\Conform\\Play\\Saves"}, "expect": {"reply": {"version": 8, "state": "tombstoned", "below": false}}},
    {"request": {"op": "reg-key", "path": "\\Registry\\Machine\\Software\\Conform\\Play\\Saves"}, "expect": {"reply": {"version": 8, "node": null}}},
    {"request": {"op": "reg-changed", "path": "\\Registry\\Machine\\Software\\Conform\\Play\\Saves", "subtree": false, "since": 7}, "expect": {"reply": {"version": 8, "changed": true}}, "note": "wire.md 4.3: deleted with an ancestor"},
    {"request": {"op": "reg-create-key", "path": "\\Registry\\Machine\\Software\\Conform\\Play", "volatile": false}, "expect": {"reply": {"version": 9}}},
    {"request": {"op": "reg-key", "path": "\\Registry\\Machine\\Software\\Conform\\Play"}, "expect": {"reply": {"version": 9, "node": {"created": true, "volatile": false, "last_write": 0, "values": [], "value_tombstones": [], "children": []}}}, "note": "wire.md 4.3: \"everything below it is dropped\": no values, no subkey"},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\Conform\\Play\\Saves"}, "expect": {"reply": {"version": 9, "state": "absent", "below": false}}, "note": "wire.md 4.3, 4.4: no node and no tombstone"},
    {"request": {"op": "reg-delete-key", "path": "\\Registry\\Machine\\Software\\Conform\\Play"}, "expect": {"reply": {"version": 10}}},
    {"request": {"op": "reg-delete-key", "path": "\\Registry\\Machine\\Software\\Conform\\Play"}, "expect": {"status": "not-found"}, "note": "wire.md 4.3: already tombstoned"},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\Conform\\Play"}, "expect": {"reply": {"version": 10, "state": "tombstoned", "below": false}}}
  ]
}
