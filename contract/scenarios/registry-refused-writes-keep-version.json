{
  "name": "registry-refused-writes-keep-version",
  "description": "A refused registry write leaves the overlay's version alone (wire.md 4.3: \"a refused write leaves it alone\"): REG_CREATE_KEY of an existing node, REG_DELETE_KEY of a tombstoned key, REG_DELETE_VALUE under a tombstone, REG_RENAME_KEY onto another node or to a bad leaf, and a value name past its limit, each followed by a read whose version is unchanged.",
  "tree": {
    "roots": [
      {"id": 0, "files": [{"path": "a.txt", "contents": "a"}]}
    ],
    "registry": {"keys": [{"path": "\\Registry\\Machine\\Software\\Conform\\A", "values": [{"name": "v", "ty": 4, "data": {"hex": "01000000"}}]}, {"path": "\\Registry\\Machine\\Software\\Conform\\B"}]}
  },
  "steps": [
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\Conform\\A"}, "expect": {"reply": {"version": 3, "state": "created", "below": false}}},
    {"request": {"op": "reg-create-key", "path": "\\Registry\\Machine\\Software\\Conform\\A", "volatile": false}, "expect": {"status": "exists"}},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\Conform\\A"}, "expect": {"reply": {"version": 3, "state": "created", "below": false}}},
    {"request": {"op": "reg-delete-key", "path": "\\Registry\\Machine\\Software\\Conform\\Gone"}, "expect": {"reply": {"version": 4}}},
    {"request": {"op": "reg-delete-key", "path": "\\Registry\\Machine\\Software\\Conform\\Gone"}, "expect": {"status": "not-found"}},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\Conform\\Gone"}, "expect": {"reply": {"version": 4, "state": "tombstoned", "below": false}}},
    {"request": {"op": "reg-delete-value", "path": "\\Registry\\Machine\\Software\\Conform\\Gone\\Under", "name": "v"}, "expect": {"status": "not-found"}, "note": "under a tombstone"},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\Conform\\A"}, "expect": {"reply": {"version": 4, "state": "created", "below": false}}},
    {"request": {"op": "reg-rename-key", "path": "\\Registry\\Machine\\Software\\Conform\\A", "new_leaf": "b"}, "expect": {"status": "exists"}, "note": "another node"},
    {"request": {"op": "reg-rename-key", "path": "\\Registry\\Machine\\Software\\Conform\\A", "new_leaf": ""}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-rename-key", "path": "\\Registry\\Machine\\Software\\Conform\\A", "new_leaf": "x\\y"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\Conform\\A"}, "expect": {"reply": {"version": 4, "state": "created", "below": false}}},
    {"request": {"op": "reg-set-value", "path": "\\Registry\\Machine\\Software\\Conform\\A", "name": "", "ty": 4, "data": {"hex": "00"}}, "expect": {"status": "bad-request"}, "note": "a value name past 16 383 units"},
    {"request": {"op": "reg-lookup", "path": "\\Registry\\Machine\\Software\\Conform\\B"}, "expect": {"reply": {"version": 4, "state": "created", "below": false}}}
  ]
}
