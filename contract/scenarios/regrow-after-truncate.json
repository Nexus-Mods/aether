{
  "name": "regrow-after-truncate",
  "description": "A file cut by SETATTR or a truncating OPEN, then grown again by a WRITE past its end: the bytes the cut removed read as zeros, not as they were (wire.md 3.4.5: the bytes between the old end and the WRITE's offset \"read as zeros\"; 3.4.6: \"bytes a truncation cut off included when the file grows again\"). A zero-length WRITE past the end grows nothing (3.4.5).",
  "tree": {
    "roots": [
      {"id": 0, "files": [{"path": "saves/g.bin", "contents": "abcdefgh"}, {"path": "saves/u", "contents": "UVWXYZ"}], "writable": ["saves"]}
    ]
  },
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["read", "write"], "path": "saves/g.bin"}, "expect": {"reply": {"fh": 1, "size": 8, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "setattr", "fh": 1, "size": 3}, "expect": {"status": "ok"}},
    {"request": {"op": "write", "fh": 1, "offset": 6, "data": "XY"}, "expect": {"reply": {"written": 2}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 64}, "expect": {"reply": {"data": {"hex": "6162630000005859"}}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/g.bin"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 8, "mtime": 0}}},
    {"request": {"op": "setattr", "fh": 1, "size": 0}, "expect": {"status": "ok"}},
    {"request": {"op": "write", "fh": 1, "offset": 3, "data": "Q"}, "expect": {"reply": {"written": 1}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 64}, "expect": {"reply": {"data": {"hex": "00000051"}}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/g.bin"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 4, "mtime": 0}}},
    {"request": {"op": "write", "fh": 1, "offset": 100, "data": ""}, "expect": {"reply": {"written": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/g.bin"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 4, "mtime": 0}}, "note": "a zero-length WRITE past the end grows nothing"},
    {"request": {"op": "open", "root": 0, "flags": ["write", "trunc"], "path": "saves/u"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 2, "offset": 4, "data": "Z"}, "expect": {"reply": {"written": 1}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/u"}, "expect": {"reply": {"fh": 3, "size": 5, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 3, "offset": 0, "len": 64}, "expect": {"reply": {"data": {"hex": "000000005a"}}}},
    {"request": {"op": "close", "fh": 3}, "expect": {"status": "ok"}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/g.bin"}, "expect": {"reply": {"fh": 4, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 4, "offset": 0, "len": 64}, "expect": {"reply": {"data": {"hex": "00000051"}}}},
    {"request": {"op": "close", "fh": 4}, "expect": {"status": "ok"}}
  ]
}
