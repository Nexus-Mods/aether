{
  "name": "rename-case-fold-source",
  "description": "RENAME finds `from` under the fold (wire.md 3.2), whatever its case, and a rename whose target differs from an existing name only by case replaces that entry rather than adding one.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "saves/Alpha.txt", "contents": "alpha"},
        {"path": "saves/Beta.txt", "contents": "beta"}
      ],
       "writable": ["saves"]}
    ]
  },
  "steps": [
    {"request": {"op": "rename", "root": 0, "from": "saves/ALPHA.TXT", "to": "saves/gamma.txt"}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/alpha.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "rename", "root": 0, "from": "saves/gamma.txt", "to": "saves/BETA.txt"}, "expect": {"status": "ok"}, "note": "the fold of `to` is an existing name: that file is replaced"},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "BETA.txt", "is_dir": false, "size": 5, "mtime": 0}]}}}
  ]
}
