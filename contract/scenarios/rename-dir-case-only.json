{
  "name": "rename-dir-case-only",
  "description": "A RENAME that changes only the case respells a directory, and everything under it keeps its place: READDIR lists the new spelling and the same children, STORED_NAMES of a path below it answers the new spelling with the children's own (wire.md 3.4.7: \"a rename that changes only the case respells the name\"; 3.4.12); a file created below through a differently cased parent leaves the parent as stored (3.2); a file respelled the same way lists and resolves under its new spelling.",
  "tree": {"roots": [{"id": 0, "files": [{"path": "saves/Dir/Child.txt", "contents": "c"}, {"path": "saves/Dir/Sub/Deep.bin", "contents": "deep"}], "writable": ["saves"]}]},
  "steps": [
    {"request": {"op": "rename", "root": 0, "from": "saves/dir", "to": "saves/dIR"}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "dIR", "is_dir": true, "size": 0, "mtime": 0}]}}, "note": "wire.md 3.4.7: respelled, not replaced"},
    {"request": {"op": "readdir", "root": 0, "path": "saves/DIR"}, "expect": {"reply": {"entries": [{"name": "Child.txt", "is_dir": false, "size": 1, "mtime": 0}, {"name": "Sub", "is_dir": true, "size": 0, "mtime": 0}]}}, "note": "wire.md 3.4.7: its children are there still"},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "saves/dir/child.txt"}, "expect": {"reply": {"names": "saves/dIR/Child.txt"}}, "note": "wire.md 3.4.12: the new spelling, and the child's own"},
    {"request": {"op": "stored-names", "root": 0, "skip": 1, "path": "saves/dir/sub/deep.bin"}, "expect": {"reply": {"names": "dIR/Sub/Deep.bin"}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/dir/sub/deep.bin"}, "expect": {"reply": {"fh": 1, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 64}, "expect": {"reply": {"data": "deep"}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "saves/DIR/new.txt"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "dIR", "is_dir": true, "size": 0, "mtime": 0}]}}, "note": "wire.md 3.2: a creating request's parents keep their stored spelling"},
    {"request": {"op": "readdir", "root": 0, "path": "saves/dir"}, "expect": {"reply": {"entries": [{"name": "Child.txt", "is_dir": false, "size": 1, "mtime": 0}, {"name": "new.txt", "is_dir": false, "size": 0, "mtime": 0}, {"name": "Sub", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "stored-names", "root": 0, "skip": 1, "path": "saves/dir/new.txt"}, "expect": {"reply": {"names": "dIR/new.txt"}}},
    {"request": {"op": "rename", "root": 0, "from": "saves/dIR/Sub", "to": "saves/dIR/SUB"}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves/dir"}, "expect": {"reply": {"entries": [{"name": "Child.txt", "is_dir": false, "size": 1, "mtime": 0}, {"name": "new.txt", "is_dir": false, "size": 0, "mtime": 0}, {"name": "SUB", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "saves/dir/sub/deep.bin"}, "expect": {"reply": {"names": "saves/dIR/SUB/Deep.bin"}}},
    {"request": {"op": "rename", "root": 0, "from": "saves/dir/child.txt", "to": "saves/dir/CHILD.TXT"}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves/dir"}, "expect": {"reply": {"entries": [{"name": "CHILD.TXT", "is_dir": false, "size": 1, "mtime": 0}, {"name": "new.txt", "is_dir": false, "size": 0, "mtime": 0}, {"name": "SUB", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "saves/dir/child.txt"}, "expect": {"reply": {"names": "saves/dIR/CHILD.TXT"}}, "note": "wire.md 3.2, 3.4.7: the leaf respelled, its parent as stored"},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/dir/child.txt"}, "expect": {"reply": {"fh": 3, "size": 1, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 3, "offset": 0, "len": 64}, "expect": {"reply": {"data": "c"}}},
    {"request": {"op": "close", "fh": 3}, "expect": {"status": "ok"}}
  ]
}
