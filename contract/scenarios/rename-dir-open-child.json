{
  "name": "rename-dir-open-child",
  "description": "A directory renamed while a file under it is open: the child opens by the new path and not by the old one, the open handle reads it still (wire.md 3.4.7: \"a directory moves with everything under it\"; \"Its handles follow it ... and so for a file under a renamed directory\"), STORED_NAMES gives the new spelling, a directory made at the old name is empty and its new file is another file, and the moved directory renamed back onto that empty directory replaces it (3.4.7).",
  "tree": {"roots": [{"id": 0, "files": [{"path": "saves/dir/sub/f.txt", "contents": "abc"}, {"path": "saves/dir/g.txt", "contents": "g"}], "writable": ["saves"]}]},
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/dir/sub/f.txt"}, "expect": {"reply": {"fh": 1, "size": 3, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/dir"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": true, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "rename", "root": 0, "from": "saves/dir", "to": "saves/Moved"}, "expect": {"status": "ok"}, "note": "wire.md 3.4.7: with open handles below it"},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/moved/sub/f.txt"}, "expect": {"reply": {"fh": 3, "size": 3, "is_dir": false, "immutable": false, "mount_gen": 0}}, "note": "wire.md 3.4.7: the child by its new path"},
    {"request": {"op": "read", "fh": 3, "offset": 0, "len": 64}, "expect": {"reply": {"data": "abc"}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/dir/sub/f.txt"}, "expect": {"status": "not-found"}, "note": "wire.md 3.4.7: and not by its old one"},
    {"request": {"op": "getattr", "root": 0, "path": "saves/dir/g.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/dir"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "Moved", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "readdir", "root": 0, "path": "saves/moved"}, "expect": {"reply": {"entries": [{"name": "g.txt", "is_dir": false, "size": 1, "mtime": 0}, {"name": "sub", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 64}, "expect": {"reply": {"data": "abc"}}, "note": "wire.md 3.4.7: the handle opened by the old path follows its file"},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "saves/moved/sub/f.txt"}, "expect": {"reply": {"names": "saves/Moved/sub/f.txt"}}, "note": "wire.md 3.4.12"},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "saves/dir"}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves/dir"}, "expect": {"reply": {"entries": []}}, "note": "wire.md 3.4.7, 3.4.9: nothing of the old directory is left at its name"},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create", "excl"], "path": "saves/dir/f.txt"}, "expect": {"reply": {"fh": 4, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}, "note": "wire.md 3.4.3: no file at that name"},
    {"request": {"op": "write", "fh": 4, "offset": 0, "data": "newer"}, "expect": {"reply": {"written": 5}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 64}, "expect": {"reply": {"data": "abc"}}, "note": "wire.md 3.4.7: never the file later created at an old name"},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/dir/f.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 5, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/moved/sub/f.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 3, "mtime": 0}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "close", "fh": 3}, "expect": {"status": "ok"}},
    {"request": {"op": "close", "fh": 4}, "expect": {"status": "ok"}},
    {"request": {"op": "delete", "root": 0, "path": "saves/dir/f.txt"}, "expect": {"status": "ok"}},
    {"request": {"op": "rename", "root": 0, "from": "saves/moved", "to": "saves/dir"}, "expect": {"status": "ok"}, "note": "wire.md 3.4.7: an empty directory at `to` is replaced"},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "dir", "is_dir": true, "size": 0, "mtime": 0}]}}, "note": "wire.md 3.4.7: in the spelling `to` gave"},
    {"request": {"op": "readdir", "root": 0, "path": "saves/dir"}, "expect": {"reply": {"entries": [{"name": "g.txt", "is_dir": false, "size": 1, "mtime": 0}, {"name": "sub", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/dir/sub/f.txt"}, "expect": {"reply": {"fh": 5, "size": 3, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 5, "offset": 0, "len": 64}, "expect": {"reply": {"data": "abc"}}},
    {"request": {"op": "close", "fh": 5}, "expect": {"status": "ok"}}
  ]
}
