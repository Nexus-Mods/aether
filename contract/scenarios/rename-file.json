{
  "name": "rename-file",
  "description": "RENAME moves a file: the old name is gone, the new name has the file (wire.md 3.4.7: \"A file or a directory moves\"), with its contents; `to` may be in another directory.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "saves/a.txt", "contents": "AAA"},
        {"path": "saves/b.txt", "contents": "BBBB"},
        {"path": "saves/foo.txt", "contents": "foo"},
        {"path": "data/ro.txt", "contents": "ro"},
        {"path": "saves/dir/one.txt", "contents": "1"},
        {"path": "saves/dir/sub/two.txt", "contents": "22"},
        {"path": "saves/full/x.txt", "contents": "x"}
      ],
       "dirs": ["saves/empty", "saves/empty2"],
       "writable": ["saves"]}
    ]
  },
  "steps": [
    {"request": {"op": "rename", "root": 0, "from": "saves/a.txt", "to": "saves/moved.txt"}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/a.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/moved.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 3, "mtime": 0}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/moved.txt"}, "expect": {"reply": {"fh": 1, "size": 3, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 8}, "expect": {"reply": {"data": "AAA"}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "rename", "root": 0, "from": "saves/moved.txt", "to": "saves/empty/deeper.txt"}, "expect": {"status": "ok"}, "note": "into another directory"},
    {"request": {"op": "getattr", "root": 0, "path": "saves/empty/deeper.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 3, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/moved.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}}
  ]
}
