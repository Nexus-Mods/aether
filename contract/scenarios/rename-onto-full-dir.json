{
  "name": "rename-onto-full-dir",
  "description": "A directory at `to` with anything under it is ST_IO_ERROR and nothing moves (wire.md 3.4.7).",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "saves/a.txt", "contents": "AAA"},
        {"path": "saves/b.txt", "contents": "BBBB"},
        {"path": "saves/foo.txt", "contents": "foo"},
        {"path": "data/ro.txt", "contents": "ro"},
        {"path": "saves/dir/one.txt", "contents": "1"},
        {"path": "saves/dir/sub/two.txt", "contents": "22"},
        {"path": "saves/full/x.txt", "contents": "x"}
      ],
       "dirs": ["saves/empty", "saves/empty2"],
       "writable": ["saves"]}
    ]
  },
  "steps": [
    {"request": {"op": "rename", "root": 0, "from": "saves/a.txt", "to": "saves/full"}, "expect": {"status": "io-error"}, "note": "a file onto a directory with a file in it"},
    {"request": {"op": "rename", "root": 0, "from": "saves/dir", "to": "saves/full"}, "expect": {"status": "io-error"}, "note": "a directory onto a directory with a file in it"},
    {"request": {"op": "getattr", "root": 0, "path": "saves/a.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 3, "mtime": 0}}, "note": "nothing moved"},
    {"request": {"op": "getattr", "root": 0, "path": "saves/dir/one.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 1, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/full/x.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 1, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/full/one.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}}
  ]
}
