{
  "name": "rename-refused",
  "description": "RENAME refusals (wire.md 3.4.7, 3.5): a `to` inside `from` is ST_BAD_REQUEST from a layer provider and the reference, ST_IO_ERROR from a disk-backed upper; a missing `from` is ST_NOT_FOUND; either end outside every writable provider is ST_READ_ONLY; nothing moves in any of them.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "saves/a.txt", "contents": "AAA"},
        {"path": "saves/b.txt", "contents": "BBBB"},
        {"path": "saves/foo.txt", "contents": "foo"},
        {"path": "data/ro.txt", "contents": "ro"},
        {"path": "saves/dir/one.txt", "contents": "1"},
        {"path": "saves/dir/sub/two.txt", "contents": "22"},
        {"path": "saves/full/x.txt", "contents": "x"}
      ],
       "dirs": ["saves/empty", "saves/empty2"],
       "writable": ["saves"]}
    ]
  },
  "steps": [
    {"request": {"op": "rename", "root": 0, "from": "saves/dir", "to": "saves/dir/sub/inside"}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "io-error"}], "wire": "3.4.7"}, "note": "`to` inside `from`"},
    {"request": {"op": "rename", "root": 0, "from": "saves/dir", "to": "saves/dir/inside"}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "io-error"}], "wire": "3.4.7"}},
    {"request": {"op": "rename", "root": 0, "from": "saves/missing.txt", "to": "saves/x.txt"}, "expect": {"status": "not-found"}},
    {"request": {"op": "rename", "root": 0, "from": "saves/nodir/missing.txt", "to": "saves/x.txt"}, "expect": {"status": "not-found"}, "note": "a missing `from` under a missing directory"},
    {"request": {"op": "rename", "root": 0, "from": "data/ro.txt", "to": "saves/x.txt"}, "expect": {"status": "read-only"}, "note": "`from` outside every writable provider"},
    {"request": {"op": "rename", "root": 0, "from": "saves/a.txt", "to": "data/x.txt"}, "expect": {"status": "read-only"}, "note": "`to` outside every writable provider"},
    {"request": {"op": "getattr", "root": 0, "path": "saves/a.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 3, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "data/ro.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 2, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/dir/sub/two.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 2, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/x.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}}
  ]
}
