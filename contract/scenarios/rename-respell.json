{
  "name": "rename-respell",
  "description": "`to` is stored with the caller's spelling, so a rename that changes only the case respells the name (wire.md 3.4.7: \"a rename that changes only the case respells the name\"), and READDIR and STORED_NAMES say so.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "saves/a.txt", "contents": "AAA"},
        {"path": "saves/b.txt", "contents": "BBBB"},
        {"path": "saves/foo.txt", "contents": "foo"},
        {"path": "data/ro.txt", "contents": "ro"},
        {"path": "saves/dir/one.txt", "contents": "1"},
        {"path": "saves/dir/sub/two.txt", "contents": "22"},
        {"path": "saves/full/x.txt", "contents": "x"}
      ],
       "dirs": ["saves/empty", "saves/empty2"],
       "writable": ["saves"]}
    ]
  },
  "steps": [
    {"request": {"op": "rename", "root": 0, "from": "saves/foo.txt", "to": "saves/Foo.TXT"}, "expect": {"status": "ok"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 1, "path": "saves/foo.txt"}, "expect": {"reply": {"names": "Foo.TXT"}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/foo.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 3, "mtime": 0}}, "note": "found under the fold, whatever the spelling"},
    {"request": {"op": "rename", "root": 0, "from": "saves/b.txt", "to": "saves/Renamed.Txt"}, "expect": {"status": "ok"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "saves/renamed.txt"}, "expect": {"reply": {"names": "saves/Renamed.Txt"}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/b.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}}
  ]
}
