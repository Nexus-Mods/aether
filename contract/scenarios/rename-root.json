{
  "name": "rename-root",
  "description": "RENAME with the root itself at either end is ST_BAD_REQUEST or ST_IO_ERROR (wire.md 3.4.7: \"The root itself at either end, or a `to` inside `from`, is `ST_BAD_REQUEST` (as the reference director answers) or `ST_IO_ERROR`\"), said for a name the writable provider holds, so the root is writable as a whole here; nothing moves.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [{"path": "a.txt", "contents": "AAA"}],
       "dirs": ["d"],
       "writable": ["."]}
    ]
  },
  "steps": [
    {"request": {"op": "rename", "root": 0, "from": ".", "to": "x"}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "io-error"}], "wire": "3.4.7"}, "note": "the root as `from`"},
    {"request": {"op": "rename", "root": 0, "from": "a.txt", "to": "."}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "io-error"}], "wire": "3.4.7"}, "note": "the root as `to`"},
    {"request": {"op": "rename", "root": 0, "from": ".", "to": "."}, "expect": {"one_of": [{"status": "bad-request"}, {"status": "io-error"}], "wire": "3.4.7"}},
    {"request": {"op": "getattr", "root": 0, "path": "a.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 3, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "x"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}}
  ]
}
