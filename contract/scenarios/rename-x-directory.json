{
  "name": "rename-x-directory",
  "description": "RENAME_X of a directory is ST_CROSS_ROOT (wire.md 3.4.13, 3.5: \"RENAME_X of a directory\"), and nothing moves; an empty directory and a directory with contents alike.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "saves/a.txt", "contents": "AAA"},
        {"path": "saves/dir/x.txt", "contents": "x"}
      ],
       "dirs": ["saves/empty"],
       "writable": ["."]},
      {"id": 1,
       "files": [
        {"path": "keep/old.txt", "contents": "old!"},
        {"path": "here/there/z.txt", "contents": "z"}
      ],
       "dirs": ["moved", "Cased", "Other"],
       "writable": ["."]}
    ]
  },
  "steps": [
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 1, "from": "saves/dir", "to": "d"}, "expect": {"status": "cross-root"}},
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 1, "from": "saves/empty", "to": "e"}, "expect": {"status": "cross-root"}},
    {"request": {"op": "rename-x", "from_root": 1, "to_root": 0, "from": "here", "to": "h"}, "expect": {"status": "cross-root"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/dir/x.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 1, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 1, "path": "d/x.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 1, "path": "here/there/z.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 1, "mtime": 0}}}
  ]
}
