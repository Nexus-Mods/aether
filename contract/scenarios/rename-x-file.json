{
  "name": "rename-x-file",
  "description": "RENAME_X moves a file between roots: it is copied to `to_root`, replacing what is there, and removed from `from_root` (wire.md 3.4.13: \"A file is copied to `to_root` (replacing what is there) and removed from `from_root`\").",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "saves/a.txt", "contents": "AAA"},
        {"path": "saves/dir/x.txt", "contents": "x"}
      ],
       "dirs": ["saves/empty"],
       "writable": ["."]},
      {"id": 1,
       "files": [
        {"path": "keep/old.txt", "contents": "old!"},
        {"path": "here/there/z.txt", "contents": "z"}
      ],
       "dirs": ["moved", "Cased", "Other"],
       "writable": ["."]}
    ]
  },
  "steps": [
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 1, "from": "saves/a.txt", "to": "moved/a.txt"}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/a.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 1, "path": "moved/a.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 3, "mtime": 0}}},
    {"request": {"op": "open", "root": 1, "flags": ["read"], "path": "moved/a.txt"}, "expect": {"reply": {"fh": 1, "size": 3, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 8}, "expect": {"reply": {"data": "AAA"}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "rename-x", "from_root": 1, "to_root": 0, "from": "keep/old.txt", "to": "saves/dir/x.txt"}, "expect": {"status": "ok"}, "note": "replacing an existing file, and the other way round"},
    {"request": {"op": "getattr", "root": 1, "path": "keep/old.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/dir/x.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 4, "mtime": 0}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/dir/x.txt"}, "expect": {"reply": {"fh": 2, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 8}, "expect": {"reply": {"data": "old!"}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 1, "from": "saves/dir/x.txt", "to": "Cased/Name.TXT"}, "expect": {"status": "ok"}},
    {"request": {"op": "stored-names", "root": 1, "skip": 0, "path": "cased/name.txt"}, "expect": {"reply": {"names": "Cased/Name.TXT"}}, "note": "the target keeps the caller's spelling (3.2)"}
  ]
}
