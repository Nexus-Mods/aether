{
  "name": "rename-x-read-both",
  "description": "RENAME_X moves a file between roots with the bytes it has now: written and cut through a handle still open, it reads in `to_root` as written and is gone from `from_root` (wire.md 3.4.13: \"A file is copied to `to_root` ... and removed from `from_root`\"), and that handle may follow it or fail (3.4.7). A RENAME_X onto a file that has an open handle replaces it; that handle may read the replaced file's last bytes or fail, never the new file (3.4.8). Moved back, the file reads in its first root again. Both roots are writable as a whole (contract/scenarios/README.md, \"Tree\").",
  "tree": {"roots": [{"id": 0, "files": [{"path": "same.txt", "contents": "s0"}], "writable": ["."]}, {"id": 1, "files": [{"path": "same.txt", "contents": "s1!!"}, {"path": "keep.txt", "contents": "k"}], "dirs": ["moved"], "writable": ["."]}]},
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "a.bin"}, "expect": {"reply": {"fh": 1, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 1, "offset": 0, "data": {"size": 5000, "seed": 4}}, "expect": {"reply": {"written": 5000}}},
    {"request": {"op": "setattr", "fh": 1, "size": 4000}, "expect": {"status": "ok"}},
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 1, "from": "a.bin", "to": "moved/A.bin"}, "expect": {"status": "ok"}, "note": "wire.md 3.4.13: with a handle open on it"},
    {"request": {"op": "getattr", "root": 0, "path": "a.bin"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}, "note": "wire.md 3.4.13: removed from from_root"},
    {"request": {"op": "readdir", "root": 0, "path": "."}, "expect": {"reply": {"entries": [{"name": "same.txt", "is_dir": false, "size": 2, "mtime": 0}]}}},
    {"request": {"op": "getattr", "root": 1, "path": "moved/a.bin"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 4000, "mtime": 0}}, "note": "wire.md 3.4.13: the bytes it had, the SETATTR included"},
    {"request": {"op": "open", "root": 1, "flags": ["read"], "path": "moved/a.bin"}, "expect": {"reply": {"fh": 2, "size": 4000, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 5000}, "expect": {"reply": {"data": {"size": 4000, "seed": 4}}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"one_of": [{"reply": {"data": {"hex": "4347fe85841649f6e1ffeee063c6d968"}}}, {"status": "io-error"}, {"status": "not-found"}], "wire": "3.4.7"}, "note": "wire.md 3.4.7: after a RENAME_X a handle may follow its file or answer as for a deleted one"},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}, "note": "wire.md 3.4.8: its CLOSE is ST_OK either way"},
    {"request": {"op": "stored-names", "root": 1, "skip": 0, "path": "moved/a.bin"}, "expect": {"reply": {"names": "moved/A.bin"}}, "note": "wire.md 3.4.13: the caller's spelling"},
    {"request": {"op": "open", "root": 1, "flags": ["read"], "path": "same.txt"}, "expect": {"reply": {"fh": 3, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 3, "offset": 0, "len": 16}, "expect": {"reply": {"data": "s1!!"}}},
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 1, "from": "same.txt", "to": "same.txt"}, "expect": {"status": "ok"}, "note": "wire.md 3.4.13: replacing a file that has an open handle"},
    {"request": {"op": "getattr", "root": 1, "path": "same.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 2, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "same.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "open", "root": 1, "flags": ["read"], "path": "same.txt"}, "expect": {"reply": {"fh": 4, "size": 2, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 4, "offset": 0, "len": 16}, "expect": {"reply": {"data": "s0"}}},
    {"request": {"op": "close", "fh": 4}, "expect": {"status": "ok"}},
    {"request": {"op": "read", "fh": 3, "offset": 0, "len": 16}, "expect": {"one_of": [{"reply": {"data": "s1!!"}}, {"status": "io-error"}, {"status": "not-found"}], "wire": "3.4.8"}, "note": "wire.md 3.4.8: the replaced file's last bytes or a failure, never the file now at the name"},
    {"request": {"op": "close", "fh": 3}, "expect": {"status": "ok"}},
    {"request": {"op": "rename-x", "from_root": 1, "to_root": 0, "from": "moved/a.bin", "to": "back.bin"}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 1, "path": "moved/a.bin"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "readdir", "root": 1, "path": "moved"}, "expect": {"reply": {"entries": []}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "back.bin"}, "expect": {"reply": {"fh": 5, "size": 4000, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 5, "offset": 0, "len": 5000, "slot_flags": ["read_bulk"]}, "expect": {"reply": {"data": {"size": 4000, "seed": 4}}}},
    {"request": {"op": "close", "fh": 5}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 1, "path": "."}, "expect": {"reply": {"entries": [{"name": "same.txt", "is_dir": false, "size": 2, "mtime": 0}, {"name": "keep.txt", "is_dir": false, "size": 1, "mtime": 0}, {"name": "moved", "is_dir": true, "size": 0, "mtime": 0}]}}}
  ]
}
