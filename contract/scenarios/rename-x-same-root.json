{
  "name": "rename-x-same-root",
  "description": "RENAME_X with equal roots behaves as RENAME (wire.md 3.4.13: \"Equal roots behave as RENAME\"): a file moves, a directory moves with its contents, a case-only change respells, the root is ST_BAD_REQUEST, a missing `from` is ST_NOT_FOUND.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "saves/a.txt", "contents": "AAA"},
        {"path": "saves/dir/x.txt", "contents": "x"}
      ],
       "dirs": ["saves/empty"],
       "writable": ["."]},
      {"id": 1,
       "files": [
        {"path": "keep/old.txt", "contents": "old!"},
        {"path": "here/there/z.txt", "contents": "z"}
      ],
       "dirs": ["moved", "Cased", "Other"],
       "writable": ["."]}
    ]
  },
  "steps": [
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 0, "from": "saves/a.txt", "to": "saves/b.txt"}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/a.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/b.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 3, "mtime": 0}}},
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 0, "from": "saves/dir", "to": "saves/dir2"}, "expect": {"status": "ok"}, "note": "a directory is fine within one root"},
    {"request": {"op": "getattr", "root": 0, "path": "saves/dir2/x.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 1, "mtime": 0}}},
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 0, "from": "saves/b.txt", "to": "saves/B.TXT"}, "expect": {"status": "ok"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 1, "path": "saves/b.txt"}, "expect": {"reply": {"names": "B.TXT"}}},
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 0, "from": ".", "to": "x"}, "expect": {"status": "bad-request"}},
    {"request": {"op": "rename-x", "from_root": 0, "to_root": 0, "from": "saves/nope", "to": "saves/x"}, "expect": {"status": "not-found"}}
  ]
}
