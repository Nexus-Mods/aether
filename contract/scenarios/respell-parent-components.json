{
  "name": "respell-parent-components",
  "description": "A creating request whose parent components are spelled otherwise than stored (RENAME's `to`, MKDIR, a create OPEN, RENAME_X's `to`) stores its leaf in the caller's spelling and leaves the parents as they are (wire.md 3.2: a creating request carries the caller's spelling for the name it creates; 3.4.13: \"the components above it keep theirs\"). Both roots are writable as a whole (contract/scenarios/README.md, \"Tree\").",
  "tree": {"roots": [{"id": 0, "files": [{"path": "Saves/Dir/a.txt", "contents": "a"}], "writable": ["."]}, {"id": 1, "files": [{"path": "Other/x.txt", "contents": "x"}], "writable": ["."]}]},
  "steps": [
    {"request": {"op": "rename", "root": 0, "from": "saves/dir/a.txt", "to": "SAVES/DIR/B.txt"}, "expect": {"status": "ok"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "saves/dir/b.txt"}, "expect": {"reply": {"names": "Saves/Dir/B.txt"}}, "note": "wire.md 3.2: only the leaf is the caller's"},
    {"request": {"op": "readdir", "root": 0, "path": "."}, "expect": {"reply": {"entries": [{"name": "Saves", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "Dir", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "SAVES/dir/Sub"}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "Dir", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "readdir", "root": 0, "path": "saves/dir"}, "expect": {"reply": {"entries": [{"name": "B.txt", "is_dir": false, "size": 1, "mtime": 0}, {"name": "Sub", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "SAVES/DIR/sub/N.txt"}, "expect": {"reply": {"fh": 1, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "saves/dir/sub/n.txt"}, "expect": {"reply": {"names": "Saves/Dir/Sub/N.txt"}}},
    {"request": {"op": "rename-x", "from_root": 1, "to_root": 0, "from": "other/x.txt", "to": "SAVES/DIR/SUB/X.txt"}, "expect": {"status": "ok"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "saves/dir/sub/x.txt"}, "expect": {"reply": {"names": "Saves/Dir/Sub/X.txt"}}, "note": "wire.md 3.4.13: the components above it keep theirs"},
    {"request": {"op": "readdir", "root": 0, "path": "saves/dir/sub"}, "expect": {"reply": {"entries": [{"name": "N.txt", "is_dir": false, "size": 0, "mtime": 0}, {"name": "X.txt", "is_dir": false, "size": 1, "mtime": 0}]}}},
    {"request": {"op": "open", "root": 1, "flags": ["write", "create", "excl"], "path": "OTHER/Y.txt"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 1, "path": "."}, "expect": {"reply": {"entries": [{"name": "Other", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "stored-names", "root": 1, "skip": 0, "path": "other/y.txt"}, "expect": {"reply": {"names": "Other/Y.txt"}}}
  ]
}
