{
  "name": "root-dot-readonly",
  "description": "The root `.` where no writable provider holds it: in a root whose only writable entry is below it, and in a root with none. GETATTR finds a directory (3.4.1); MKDIR of it, and of an existing directory in a root with no writable provider, is ST_EXISTS or ST_READ_ONLY (wire.md 3.4.9: \"An existing directory no writable provider serves, the root included\"); STORED_NAMES names it `.` (3.4.12).",
  "tree": {"roots": [{"id": 0, "files": [{"path": "saves/s.txt", "contents": "s"}], "writable": ["saves"]}, {"id": 1, "files": [{"path": "data/a.esp", "contents": "abc"}]}]},
  "steps": [
    {"request": {"op": "getattr", "root": 0, "path": "."}, "expect": {"reply": {"found": true, "is_dir": true, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 1, "path": "."}, "expect": {"reply": {"found": true, "is_dir": true, "size": 0, "mtime": 0}}},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "."}, "expect": {"one_of": [{"status": "exists"}, {"status": "read-only"}], "wire": "3.4.9"}},
    {"request": {"op": "mkdir", "root": 1, "mode": 493, "path": "."}, "expect": {"one_of": [{"status": "exists"}, {"status": "read-only"}], "wire": "3.4.9"}},
    {"request": {"op": "mkdir", "root": 1, "mode": 493, "path": "data"}, "expect": {"one_of": [{"status": "exists"}, {"status": "read-only"}], "wire": "3.4.9"}},
    {"request": {"op": "stored-names", "root": 1, "skip": 0, "path": "."}, "expect": {"reply": {"names": "."}}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "."}, "expect": {"reply": {"names": "."}}},
    {"request": {"op": "readdir", "root": 0, "path": "."}, "expect": {"reply": {"entries": [{"name": "saves", "is_dir": true, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "readdir", "root": 1, "path": "."}, "expect": {"reply": {"entries": [{"name": "data", "is_dir": true, "size": 0, "mtime": 0}]}}}
  ]
}
