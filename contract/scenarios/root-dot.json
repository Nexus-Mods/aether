{
  "name": "root-dot",
  "description": "The root itself, `.` (wire.md 3.2: the root is the path `.`), in a root writable as a whole: GETATTR finds a directory of size 0 (3.4.1), MKDIR of it is an existing directory, ST_OK or ST_EXISTS (3.4.9), STORED_NAMES names it `.` (3.4.12: STORED_NAMES of it \"names the root itself\"), and it opens as a directory (3.4.3); a root the director does not serve is found = 0 (3.4.1).",
  "tree": {"roots": [{"id": 0, "files": [{"path": "a.txt", "contents": "a"}], "writable": ["."]}]},
  "steps": [
    {"request": {"op": "getattr", "root": 0, "path": "."}, "expect": {"reply": {"found": true, "is_dir": true, "size": 0, "mtime": 0}}, "note": "wire.md 3.4.1, 3.2"},
    {"request": {"op": "getattr", "root": 9, "path": "."}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}, "note": "wire.md 3.4.1: an unserved root"},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "."}, "expect": {"one_of": [{"status": "ok"}, {"status": "exists"}], "wire": "3.4.9"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "."}, "expect": {"reply": {"names": "."}}, "note": "wire.md 3.4.12"},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "."}, "expect": {"reply": {"fh": 1, "size": 0, "is_dir": true, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"status": "is-dir"}, "note": "wire.md 3.4.4: a directory handle"},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "."}, "expect": {"reply": {"entries": [{"name": "a.txt", "is_dir": false, "size": 1, "mtime": 0}]}}, "note": "nothing changed"}
  ]
}
