{
  "name": "roots-isolated",
  "description": "Every path-carrying request starts with its root, and a path means a different thing under each root (wire.md 3.2): the same path in two roots has two files, two sizes, two listings; a write in one root does not appear in the other; handles imply their root.",
  "tree": {
    "roots": [
      {"id": 0,
       "files": [
        {"path": "data/a.txt", "contents": "zero"},
        {"path": "only0.txt", "contents": "0"}
      ],
       "writable": ["w"]},
      {"id": 1,
       "files": [
        {"path": "data/a.txt", "contents": "number one"},
        {"path": "only1.txt", "contents": "11"}
      ],
       "writable": ["w"]},
      {"id": 7,
       "files": [{"path": "data/a.txt", "contents": "2"}]}
    ]
  },
  "steps": [
    {"request": {"op": "getattr", "root": 0, "path": "data/a.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 4, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 1, "path": "data/a.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 10, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 7, "path": "data/a.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 1, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "only1.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 1, "path": "only0.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "data/a.txt"}, "expect": {"reply": {"fh": 1, "size": 4, "is_dir": false, "immutable": true, "mount_gen": 0}}},
    {"request": {"op": "open", "root": 1, "flags": ["read"], "path": "data/a.txt"}, "expect": {"reply": {"fh": 2, "size": 10, "is_dir": false, "immutable": true, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 32}, "expect": {"reply": {"data": "zero"}}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 32}, "expect": {"reply": {"data": "number one"}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 1, "flags": ["write", "create"], "path": "w/new.txt"}, "expect": {"reply": {"fh": 3, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 3, "offset": 0, "data": "in one"}, "expect": {"reply": {"written": 6}}},
    {"request": {"op": "close", "fh": 3}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 1, "path": "w/new.txt"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 6, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "w/new.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 7, "path": "w/new.txt"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "readdir", "root": 0, "path": "data"}, "expect": {"reply": {"entries": [{"name": "a.txt", "is_dir": false, "size": 4, "mtime": 0}]}}},
    {"request": {"op": "readdir", "root": 1, "path": "data"}, "expect": {"reply": {"entries": [{"name": "a.txt", "is_dir": false, "size": 10, "mtime": 0}]}}},
    {"request": {"op": "readdir", "root": 1, "path": "."}, "expect": {"reply": {"entries": [{"name": "data", "is_dir": true, "size": 0, "mtime": 0}, {"name": "only1.txt", "is_dir": false, "size": 2, "mtime": 0}, {"name": "w", "is_dir": true, "size": 0, "mtime": 0}]}}}
  ]
}
