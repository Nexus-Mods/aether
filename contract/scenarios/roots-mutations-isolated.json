{
  "name": "roots-mutations-isolated",
  "description": "DELETE, a create, RENAME and MKDIR in one root leave the same relative path in another root alone (wire.md 3.2: \"Every path-carrying file request starts with the root it addresses\"): each root's files, listings and refusals are its own.",
  "tree": {"roots": [{"id": 0, "files": [{"path": "w/x", "contents": "zero"}], "writable": ["w"]}, {"id": 1, "files": [{"path": "w/x", "contents": "one!"}, {"path": "w/keep", "contents": "k"}], "writable": ["w"]}]},
  "steps": [
    {"request": {"op": "delete", "root": 0, "path": "w/x"}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 1, "path": "w/x"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 4, "mtime": 0}}, "note": "wire.md 3.2: root 1's file is another file"},
    {"request": {"op": "open", "root": 1, "flags": ["read"], "path": "w/x"}, "expect": {"reply": {"fh": 1, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"reply": {"data": "one!"}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create", "excl"], "path": "w/x"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}, "note": "wire.md 3.4.3: root 1's file does not make it exist in root 0"},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "rename", "root": 1, "from": "w/x", "to": "w/z"}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "w/z"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "getattr", "root": 0, "path": "w/x"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "w/d"}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 1, "path": "w"}, "expect": {"reply": {"entries": [{"name": "keep", "is_dir": false, "size": 1, "mtime": 0}, {"name": "z", "is_dir": false, "size": 4, "mtime": 0}]}}},
    {"request": {"op": "readdir", "root": 0, "path": "w"}, "expect": {"reply": {"entries": [{"name": "d", "is_dir": true, "size": 0, "mtime": 0}, {"name": "x", "is_dir": false, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "delete", "root": 0, "path": "W/Z"}, "expect": {"status": "not-found"}, "note": "wire.md 3.4.8: missing in root 0"},
    {"request": {"op": "getattr", "root": 1, "path": "w/z"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 4, "mtime": 0}}},
    {"request": {"op": "open", "root": 1, "flags": ["write", "create"], "path": "w/d/f"}, "expect": {"status": "not-found"}, "note": "wire.md 3.4.3: root 1 has no w/d"}
  ]
}
