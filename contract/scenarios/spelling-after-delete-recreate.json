{
  "name": "spelling-after-delete-recreate",
  "description": "A name deleted and created again in another case takes the new spelling, for a file and for a directory and a file made under it (wire.md 3.2: \"Keep the spelling a name was created with\"; 3.4.8: deleted, the name is gone); an existing file opened, written and read through other spellings keeps its own (3.2).",
  "tree": {"roots": [{"id": 0, "files": [{"path": "saves/Foo.TXT", "contents": "1"}, {"path": "saves/Dir/Kid.a", "contents": "k"}], "writable": ["saves"]}]},
  "steps": [
    {"request": {"op": "delete", "root": 0, "path": "saves/foo.txt"}, "expect": {"status": "ok"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "saves/foo.txt"}, "expect": {"one_of": [{"reply": {"names": "saves/foo.txt"}}, {"status": "not-found"}], "wire": "3.4.12"}, "note": "wire.md 3.4.12: a name the director does not have, echoed or not found; never the deleted spelling"},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "saves/fOO.tXt"}, "expect": {"reply": {"fh": 1, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 1, "offset": 0, "data": "2"}, "expect": {"reply": {"written": 1}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "Dir", "is_dir": true, "size": 0, "mtime": 0}, {"name": "fOO.tXt", "is_dir": false, "size": 1, "mtime": 0}]}}, "note": "wire.md 3.2: the spelling it was created with now"},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "saves/foo.txt"}, "expect": {"reply": {"names": "saves/fOO.tXt"}}},
    {"request": {"op": "delete", "root": 0, "path": "saves/dir/kid.a"}, "expect": {"status": "ok"}},
    {"request": {"op": "delete", "root": 0, "path": "saves/dir"}, "expect": {"status": "ok"}},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "saves/DIR"}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "saves/dir/KID.a"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "DIR", "is_dir": true, "size": 0, "mtime": 0}, {"name": "fOO.tXt", "is_dir": false, "size": 1, "mtime": 0}]}}},
    {"request": {"op": "readdir", "root": 0, "path": "saves/dir"}, "expect": {"reply": {"entries": [{"name": "KID.a", "is_dir": false, "size": 0, "mtime": 0}]}}},
    {"request": {"op": "stored-names", "root": 0, "skip": 0, "path": "saves/dir/kid.a"}, "expect": {"reply": {"names": "saves/DIR/KID.a"}}},
    {"request": {"op": "open", "root": 0, "flags": ["write"], "path": "saves/FOO.txt"}, "expect": {"reply": {"fh": 3, "size": 1, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 3, "offset": 1, "data": "3"}, "expect": {"reply": {"written": 1}}},
    {"request": {"op": "close", "fh": 3}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "SAVES/FOO.TXT"}, "expect": {"reply": {"fh": 4, "size": 2, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 4, "offset": 0, "len": 16}, "expect": {"reply": {"data": "23"}}},
    {"request": {"op": "close", "fh": 4}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/foo.TXT"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 2, "mtime": 0}}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "DIR", "is_dir": true, "size": 0, "mtime": 0}, {"name": "fOO.tXt", "is_dir": false, "size": 2, "mtime": 0}]}}, "note": "wire.md 3.2: an open of an existing name does not respell it"}
  ]
}
