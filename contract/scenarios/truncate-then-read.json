{
  "name": "truncate-then-read",
  "description": "A file truncated by an OPEN_TRUNC while other handles are open on it, and by SETATTR: every handle reads the file as it is now (wire.md 3.4.4: \"a truncating OPEN, by any client, is seen by the next READ through every other handle\"), a handle opened write|trunc reads empty at once, and when the file grows again the bytes the truncation cut read as zeros (3.4.5; 3.4.6: \"bytes a truncation cut off included\").",
  "tree": {"roots": [{"id": 0, "files": [{"path": "saves/s.bin", "contents": "0123456789"}, {"path": "saves/t.txt", "contents": "abcdef"}], "writable": ["saves"]}]},
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["write"], "path": "saves/s.bin"}, "expect": {"reply": {"fh": 1, "size": 10, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/s.bin"}, "expect": {"reply": {"fh": 2, "size": 10, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 64}, "expect": {"reply": {"data": "0123456789"}}},
    {"request": {"op": "write", "fh": 1, "offset": 10, "data": "AB"}, "expect": {"reply": {"written": 2}}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "trunc"], "path": "saves/s.bin"}, "expect": {"reply": {"fh": 3, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}, "note": "wire.md 3.4.3: truncate on open"},
    {"request": {"op": "getattr", "root": 0, "path": "saves/s.bin"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 0, "mtime": 0}}, "note": "wire.md 3.4.1"},
    {"request": {"op": "read", "fh": 3, "offset": 0, "len": 64}, "expect": {"reply": {"data": ""}}, "note": "wire.md 3.4.4: the truncating handle reads empty at once"},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 64}, "expect": {"reply": {"data": ""}}, "note": "wire.md 3.4.4: the reader sees the truncation"},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 64}, "expect": {"reply": {"data": ""}}, "note": "wire.md 3.4.4: so does the writer opened before it"},
    {"request": {"op": "write", "fh": 1, "offset": 12, "data": "Z"}, "expect": {"reply": {"written": 1}}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/s.bin"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 13, "mtime": 0}}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 64}, "expect": {"reply": {"data": {"hex": "0000000000000000000000005a"}}}, "note": "wire.md 3.4.5: the bytes before the WRITE read as zeros, the cut ones included"},
    {"request": {"op": "setattr", "fh": 3, "size": 3}, "expect": {"status": "ok"}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 64}, "expect": {"reply": {"data": {"hex": "000000"}}}},
    {"request": {"op": "write", "fh": 1, "offset": 5, "data": "Q"}, "expect": {"reply": {"written": 1}}},
    {"request": {"op": "read", "fh": 3, "offset": 0, "len": 64}, "expect": {"reply": {"data": {"hex": "000000000051"}}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "close", "fh": 3}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/s.bin"}, "expect": {"reply": {"fh": 4, "size": 6, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 4, "offset": 0, "len": 64}, "expect": {"reply": {"data": {"hex": "000000000051"}}}},
    {"request": {"op": "close", "fh": 4}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["read", "write"], "path": "saves/t.txt"}, "expect": {"reply": {"fh": 5, "size": 6, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "setattr", "fh": 5, "size": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "read", "fh": 5, "offset": 0, "len": 64}, "expect": {"reply": {"data": "ab"}}, "note": "wire.md 3.4.6: a SETATTR truncates"},
    {"request": {"op": "write", "fh": 5, "offset": 4, "data": "X"}, "expect": {"reply": {"written": 1}}},
    {"request": {"op": "read", "fh": 5, "offset": 0, "len": 64}, "expect": {"reply": {"data": {"hex": "6162000058"}}}, "note": "wire.md 3.4.6: the cut bytes read as zeros when a WRITE grows the file again"},
    {"request": {"op": "setattr", "fh": 5, "size": 8}, "expect": {"status": "ok"}},
    {"request": {"op": "read", "fh": 5, "offset": 0, "len": 64}, "expect": {"reply": {"data": {"hex": "6162000058000000"}}}},
    {"request": {"op": "close", "fh": 5}, "expect": {"status": "ok"}}
  ]
}
