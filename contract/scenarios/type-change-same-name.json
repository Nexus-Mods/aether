{
  "name": "type-change-same-name",
  "description": "A name that changes kind: a file deleted and a directory made at its name is a directory to GETATTR, OPEN and READ (wire.md 3.4.1, 3.4.3, 3.4.4: a directory handle is ST_IS_DIR); deleted again and a file created there (in another case), a file again, listed with its new spelling (3.2).",
  "tree": {"roots": [{"id": 0, "files": [{"path": "saves/x", "contents": "f"}], "writable": ["saves"]}]},
  "steps": [
    {"request": {"op": "delete", "root": 0, "path": "saves/x"}, "expect": {"status": "ok"}},
    {"request": {"op": "mkdir", "root": 0, "mode": 493, "path": "saves/x"}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/x"}, "expect": {"reply": {"found": true, "is_dir": true, "size": 0, "mtime": 0}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/x"}, "expect": {"reply": {"fh": 1, "size": 0, "is_dir": true, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 1, "offset": 0, "len": 16}, "expect": {"status": "is-dir"}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "delete", "root": 0, "path": "saves/x"}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "saves/X"}, "expect": {"reply": {"fh": 2, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 2, "offset": 0, "data": "file"}, "expect": {"reply": {"written": 4}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/x"}, "expect": {"reply": {"found": true, "is_dir": false, "size": 4, "mtime": 0}}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "X", "is_dir": false, "size": 4, "mtime": 0}]}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/x"}, "expect": {"reply": {"fh": 3, "size": 4, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 3, "offset": 0, "len": 16}, "expect": {"reply": {"data": "file"}}},
    {"request": {"op": "close", "fh": 3}, "expect": {"status": "ok"}}
  ]
}
