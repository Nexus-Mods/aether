{
  "name": "write-rename-read",
  "description": "A file written and closed, then renamed: it reads under the new name with its bytes, and the old name is gone to GETATTR, OPEN and READDIR (wire.md 3.4.7: \"A file or a directory moves\"; `to` keeps the caller's spelling). Three renames swap two files through a third name, each then read under the other's name, inline and in bulk; a rename onto an existing file replaces it with the source's bytes (3.4.7: \"A file or an empty directory at `to` is replaced\").",
  "tree": {"roots": [{"id": 0, "files": [{"path": "saves/b.bin", "contents": {"size": 70000, "seed": 6}}], "writable": ["saves"]}]},
  "steps": [
    {"request": {"op": "open", "root": 0, "flags": ["write", "create"], "path": "saves/a.tmp"}, "expect": {"reply": {"fh": 1, "size": 0, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "write", "fh": 1, "offset": 0, "data": "AAA"}, "expect": {"reply": {"written": 3}}},
    {"request": {"op": "close", "fh": 1}, "expect": {"status": "ok"}},
    {"request": {"op": "rename", "root": 0, "from": "saves/a.tmp", "to": "saves/A.dat"}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/a.tmp"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}, "note": "wire.md 3.4.7: the old name is gone"},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/a.tmp"}, "expect": {"status": "not-found"}, "note": "wire.md 3.4.3: a missing path without OPEN_CREATE"},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "A.dat", "is_dir": false, "size": 3, "mtime": 0}, {"name": "b.bin", "is_dir": false, "size": 70000, "mtime": 0}]}}, "note": "wire.md 3.4.2, 3.4.7: listed once, under the spelling `to` gave"},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/a.dat"}, "expect": {"reply": {"fh": 2, "size": 3, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 2, "offset": 0, "len": 64}, "expect": {"reply": {"data": "AAA"}}},
    {"request": {"op": "close", "fh": 2}, "expect": {"status": "ok"}},
    {"request": {"op": "stored-names", "root": 0, "skip": 1, "path": "saves/a.dat"}, "expect": {"reply": {"names": "A.dat"}}, "note": "wire.md 3.4.12"},
    {"request": {"op": "rename", "root": 0, "from": "saves/a.dat", "to": "saves/tmp"}, "expect": {"status": "ok"}},
    {"request": {"op": "rename", "root": 0, "from": "saves/b.bin", "to": "saves/a.dat"}, "expect": {"status": "ok"}},
    {"request": {"op": "rename", "root": 0, "from": "saves/tmp", "to": "saves/b.bin"}, "expect": {"status": "ok"}},
    {"request": {"op": "getattr", "root": 0, "path": "saves/tmp"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/a.dat"}, "expect": {"reply": {"fh": 3, "size": 70000, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 3, "offset": 0, "len": 70000}, "expect": {"reply": {"data": {"size": 70000, "seed": 6}}}, "note": "wire.md 3.4.7: the file moved with its bytes"},
    {"request": {"op": "read", "fh": 3, "offset": 0, "len": 70000, "slot_flags": ["read_bulk"]}, "expect": {"reply": {"data": {"size": 70000, "seed": 6}}}},
    {"request": {"op": "close", "fh": 3}, "expect": {"status": "ok"}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/b.bin"}, "expect": {"reply": {"fh": 4, "size": 3, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 4, "offset": 0, "len": 64}, "expect": {"reply": {"data": "AAA"}}},
    {"request": {"op": "close", "fh": 4}, "expect": {"status": "ok"}},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "a.dat", "is_dir": false, "size": 70000, "mtime": 0}, {"name": "b.bin", "is_dir": false, "size": 3, "mtime": 0}]}}},
    {"request": {"op": "rename", "root": 0, "from": "saves/a.dat", "to": "saves/B.BIN"}, "expect": {"status": "ok"}, "note": "wire.md 3.4.7: a file at `to` is replaced"},
    {"request": {"op": "readdir", "root": 0, "path": "saves"}, "expect": {"reply": {"entries": [{"name": "B.BIN", "is_dir": false, "size": 70000, "mtime": 0}]}}, "note": "wire.md 3.4.7: `to` is stored with the caller's spelling"},
    {"request": {"op": "getattr", "root": 0, "path": "saves/a.dat"}, "expect": {"reply": {"found": false, "is_dir": false, "size": 0, "mtime": 0}}},
    {"request": {"op": "open", "root": 0, "flags": ["read"], "path": "saves/b.bin"}, "expect": {"reply": {"fh": 5, "size": 70000, "is_dir": false, "immutable": false, "mount_gen": 0}}},
    {"request": {"op": "read", "fh": 5, "offset": 0, "len": 70000, "slot_flags": ["read_bulk"]}, "expect": {"reply": {"data": {"size": 70000, "seed": 6}}}, "note": "wire.md 3.4.7: the bytes at `to` are the source's"},
    {"request": {"op": "close", "fh": 5}, "expect": {"status": "ok"}}
  ]
}
